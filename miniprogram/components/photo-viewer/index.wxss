.photo-viewer {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: rgba(10, 10, 10, 0.28);
}

.photo-viewer__backdrop {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.photo-viewer__backdrop-image {
  width: 100%;
  height: 100%;
  filter: blur(40rpx) brightness(0.58);
  transform: scale(1.16);
}

.photo-viewer__backdrop-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12, 12, 12, 0.34), rgba(12, 12, 12, 0.56));
}

.photo-viewer__chrome {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 28rpx);
  left: 22rpx;
  right: 22rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photo-viewer__counter {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  backdrop-filter: blur(12rpx);
}

.photo-viewer__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(12rpx);
}

.photo-viewer__close-icon {
  font-size: 42rpx;
  line-height: 1;
  color: #ffffff;
}

.photo-viewer__swiper {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100vh;
}

.photo-viewer__slide {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 140rpx 24rpx calc(env(safe-area-inset-bottom) + 90rpx);
  box-sizing: border-box;
}

.photo-viewer__tap-zone {
  position: absolute;
  inset: 0;
}

.photo-viewer__image-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-viewer__movable-area {
  width: 100%;
  height: 100%;
}

.photo-viewer__movable-view {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-viewer__image {
  width: 100%;
  height: 100%;
}
