.feedback-action-sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 1590;
  display: flex;
  align-items: flex-end;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(9, 11, 13, 0.42);
}

.feedback-action-sheet-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feedback-action-sheet {
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 20rpx 48rpx rgba(17, 17, 17, 0.14);
}

.feedback-action-sheet__item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.feedback-action-sheet__item + .feedback-action-sheet__item {
  border-top: 1rpx solid rgba(17, 17, 17, 0.08);
}

.feedback-action-sheet__item-label,
.feedback-action-sheet__cancel-label {
  display: block;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 500;
}

.feedback-action-sheet__cancel-label {
  color: #111111;
}

.feedback-action-sheet--dark {
  background: linear-gradient(180deg, #171b1f, #111417);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 24rpx 54rpx rgba(0, 0, 0, 0.34);
}

.feedback-action-sheet--dark .feedback-action-sheet__item + .feedback-action-sheet__item {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.feedback-action-sheet--dark .feedback-action-sheet__cancel-label {
  color: #f2f5f7;
}
