<view class="selector-sheet-host">
  <view class="selector-trigger {{disabled ? 'selector-trigger--disabled' : ''}}" bindtap="openSheet">
    <slot></slot>
  </view>

  <view wx:if="{{open}}" class="selector-sheet-overlay" bindtap="closeSheet">
    <view class="selector-sheet selector-sheet--{{themeMode}}" catchtap="noop">
      <view class="selector-sheet__handle"></view>

      <view class="selector-sheet__head">
        <text class="selector-sheet__title">{{title}}</text>
        <text class="selector-sheet__close" bindtap="closeSheet">Cancel</text>
      </view>

      <scroll-view class="selector-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:for="{{optionLabels}}" wx:key="index">
          <view
            class="selector-sheet__option {{currentValue === index ? 'selector-sheet__option--active' : ''}}"
            data-index="{{index}}"
            bindtap="onOptionTap"
          >
            <text class="selector-sheet__option-label">{{item}}</text>
            <text wx:if="{{currentValue === index}}" class="selector-sheet__option-check">✓</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
