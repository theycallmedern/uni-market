.selector-sheet-host {
  display: block;
  flex: 1 1 0;
  min-width: 0;
}

.selector-trigger {
  display: block;
  width: 100%;
  min-width: 0;
}

.selector-trigger--disabled {
  opacity: 0.7;
}

.selector-sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: flex;
  align-items: flex-end;
  padding: 24rpx 20rpx calc(env(safe-area-inset-bottom) + 180rpx);
  box-sizing: border-box;
  background: rgba(17, 17, 17, 0.28);
}

.selector-sheet {
  width: 100%;
  max-height: calc(100vh - 240rpx);
  padding: 18rpx 24rpx 24rpx;
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17, 17, 17, 0.12);
}

.selector-sheet__handle {
  width: 88rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #dddddd;
}

.selector-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.selector-sheet__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}

.selector-sheet__close {
  font-size: 24rpx;
  color: #7c7c7c;
}

.selector-sheet__scroll {
  max-height: calc(100vh - 360rpx - env(safe-area-inset-bottom));
}

.selector-sheet__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f7f4;
}

.selector-sheet__option + .selector-sheet__option {
  margin-top: 12rpx;
}

.selector-sheet__option-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.35;
  color: #2d2d2d;
}

.selector-sheet__option-check {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #2f7d32;
}

.selector-sheet__option--active {
  background: #eef7ee;
  border: 1rpx solid rgba(47, 125, 50, 0.16);
}

.selector-sheet--dark {
  background: #171b1f;
  box-shadow: 0 -18rpx 40rpx rgba(0, 0, 0, 0.32);
}

.selector-sheet--dark .selector-sheet__handle {
  background: #2b3136;
}

.selector-sheet--dark .selector-sheet__title {
  color: #f2f5f7;
}

.selector-sheet--dark .selector-sheet__close {
  color: #8e99a3;
}

.selector-sheet--dark .selector-sheet__option {
  background: #20262b;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.selector-sheet--dark .selector-sheet__option-label {
  color: #f2f5f7;
}

.selector-sheet--dark .selector-sheet__option-check {
  color: #b7dfbe;
}

.selector-sheet--dark .selector-sheet__option--active {
  background: rgba(54, 88, 60, 0.3);
  border-color: rgba(111, 167, 121, 0.14);
}
