.feedback-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(9, 11, 13, 0.42);
}

.feedback-modal {
  width: 100%;
  max-width: 632rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 26rpx 70rpx rgba(17, 17, 17, 0.2);
}

.feedback-modal__head {
  padding: 42rpx 40rpx 0;
}

.feedback-modal__title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #111111;
}

.feedback-modal__body {
  padding: 28rpx 40rpx 38rpx;
}

.feedback-modal__content {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6e6e6e;
}

.feedback-modal__textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f5f6f8;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.45;
}

.feedback-modal__placeholder {
  color: #9aa1a8;
}

.feedback-modal__actions {
  display: flex;
  align-items: stretch;
  min-height: 96rpx;
  border-top: 1rpx solid rgba(17, 17, 17, 0.08);
}

.feedback-modal__action {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 32rpx;
  line-height: 96rpx;
  font-weight: 700;
}

.feedback-modal__action::after {
  border: 0;
}

.feedback-modal__action--cancel {
  color: #111111;
}

.feedback-modal__action--confirm {
  border-left: 1rpx solid rgba(17, 17, 17, 0.08);
}

.feedback-modal__action--single {
  border-left: 0;
}

.feedback-modal--dark {
  background: linear-gradient(180deg, #171b1f, #111417);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.42);
}

.feedback-modal--dark .feedback-modal__title {
  color: #f2f5f7;
}

.feedback-modal--dark .feedback-modal__content {
  color: #9aa5af;
}

.feedback-modal--dark .feedback-modal__textarea {
  background: #20262b;
  color: #f2f5f7;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.feedback-modal--dark .feedback-modal__placeholder {
  color: #7f8b95;
}

.feedback-modal--dark .feedback-modal__actions {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.feedback-modal--dark .feedback-modal__action--cancel {
  color: #f2f5f7;
}

.feedback-modal--dark .feedback-modal__action--confirm {
  border-left-color: rgba(255, 255, 255, 0.08);
}
