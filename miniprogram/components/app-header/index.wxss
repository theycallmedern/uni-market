.app-header {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  background: linear-gradient(180deg, rgba(250, 249, 246, 0.94), rgba(247, 247, 247, 0.88));
  backdrop-filter: blur(24rpx);
  border-bottom: 1rpx solid rgba(17, 17, 17, 0.035);
}

.app-header__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.app-header__side {
  display: flex;
  align-items: center;
}

.app-header__center {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
}

.app-header__title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.app-header__title-logo {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.82;
  flex-shrink: 0;
}

.app-header__title {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 650;
  letter-spacing: 1.3rpx;
  color: #9a978f;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.app-header__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(17, 17, 17, 0.04);
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.035);
}

.app-header__back-icon {
  font-size: 38rpx;
  line-height: 1;
  color: #1b1b1b;
  transform: translateX(-2rpx);
}
