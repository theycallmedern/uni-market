.create-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.create-scroll {
  flex: 1;
  min-height: 0;
}

.create-content {
  padding: 22rpx 24rpx 176rpx;
}

.compose-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.compose-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.08;
  font-weight: 700;
}

.compose-copy {
  display: block;
  margin-top: 10rpx;
  max-width: 500rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #707070;
}

.compose-chip {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #eef5ec;
  color: #2f7d32;
  font-size: 22rpx;
  font-weight: 600;
}

.form-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.card-hint {
  font-size: 22rpx;
  color: #8b8b8b;
}

.card-subhint {
  display: block;
  margin-top: -6rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #9a9a9a;
}

.photo-scroll {
  white-space: nowrap;
}

.photo-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 12rpx;
}

.photo-add,
.photo-card {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #f7f4ed, #efe9dd);
  color: #111111;
}

.photo-add__icon {
  font-size: 52rpx;
  line-height: 1;
}

.photo-add__text {
  font-size: 24rpx;
  font-weight: 600;
}

.photo-card__image {
  width: 100%;
  height: 100%;
  display: block;
  background: #ececec;
}

.photo-card__badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  font-weight: 700;
  color: #111111;
}

.photo-card__badge--cover {
  background: rgba(17, 17, 17, 0.84);
  color: #ffffff;
}

.photo-card__remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: rgba(17, 17, 17, 0.86);
}

.photo-card__remove-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  text-align: center;
  line-height: 44rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.photo-card__toolbar {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  gap: 8rpx;
}

.photo-tool {
  flex: 1;
  height: 42rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
  line-height: 42rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #111111;
  padding: 0;
}

.photo-tool::after {
  border: 0;
}

.field {
  margin-bottom: 16rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

.field-helper {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f7f2e6;
  color: #8a5a08;
  font-size: 22rpx;
  line-height: 1.4;
}

.field-input,
.picker-field,
.description-input {
  box-sizing: border-box;
  width: 100%;
  border-radius: 24rpx;
  background: #f5f3ee;
  color: #111111;
}

.field-input,
.picker-field {
  height: 92rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-field--locked {
  background: #ece9e3;
  color: #9a9a9a;
}

.picker-field__locked-value {
  color: #9a9a9a;
  font-weight: 600;
}

.picker-arrow {
  font-size: 28rpx;
  color: #6f6f6f;
}

.description-input {
  min-height: 220rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.publish-inline {
  padding: 8rpx 0 56rpx;
}

.publish-button {
  width: 100%;
  height: 92rpx;
  border: 0;
  padding: 0;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 18rpx 36rpx rgba(17, 17, 17, 0.08);
}

.publish-button::after {
  border: 0;
}

.create-sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 32;
  background: rgba(17, 17, 17, 0.28);
  backdrop-filter: blur(8rpx);
}

.create-sheet {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  max-height: 70vh;
  padding: 18rpx 18rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-radius: 36rpx;
  background: linear-gradient(180deg, #ffffff, #faf8f2);
  box-shadow: 0 28rpx 56rpx rgba(17, 17, 17, 0.16);
}

.create-sheet__handle {
  display: flex;
  align-self: center;
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.14);
}

.create-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 10rpx 0;
}

.create-sheet__title {
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #111111;
}

.create-sheet__close {
  font-size: 24rpx;
  font-weight: 700;
  color: #6c6c6c;
}

.create-sheet__scroll {
  display: flex;
  flex-direction: column;
  max-height: 52vh;
}

.create-sheet__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 98rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #111111;
  box-shadow: 0 10rpx 22rpx rgba(17, 17, 17, 0.04);
}

.create-sheet__option + .create-sheet__option {
  margin-top: 12rpx;
}

.create-sheet__option--active {
  background: #eef4e7;
}

.create-sheet__option-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  color: inherit;
}

.create-sheet__option-check {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f7d32;
}

.theme-dark.create-page,
.theme-dark .create-scroll {
  background: #0f1113;
}

.theme-dark .compose-title,
.theme-dark .card-title {
  color: #f2f5f7;
}

.theme-dark .compose-copy,
.theme-dark .card-hint,
.theme-dark .card-subhint,
.theme-dark .field-label {
  color: #8e99a3;
}

.theme-dark .compose-chip {
  background: rgba(54, 88, 60, 0.3);
  color: #b7dfbe;
}

.theme-dark .form-card {
  background: #171b1f;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .photo-add {
  background: linear-gradient(135deg, #242b30, #171c20);
  color: #f2f5f7;
}

.theme-dark .photo-card__image {
  background: #20262b;
}

.theme-dark .photo-card__badge {
  background: rgba(20, 24, 27, 0.88);
  color: #f2f5f7;
}

.theme-dark .photo-tool {
  background: rgba(23, 27, 31, 0.92);
  color: #f2f5f7;
}

.theme-dark .field-helper {
  background: rgba(92, 74, 28, 0.32);
  color: #e5d3a5;
}

.theme-dark .field-input,
.theme-dark .picker-field,
.theme-dark .description-input,
.theme-dark .publish-button {
  background: #20262b;
  color: #f2f5f7;
  border-color: rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .field-input::placeholder,
.theme-dark .description-input::placeholder {
  color: #8e99a3;
}

.theme-dark .picker-field--locked {
  background: #171b1f;
  color: #f2f5f7;
}

.theme-dark .picker-field__locked-value {
  color: #f2f5f7;
}

.theme-dark .picker-arrow {
  color: #8e99a3;
}

.theme-dark .create-sheet-overlay {
  background: rgba(0, 0, 0, 0.5);
}

.theme-dark .create-sheet {
  background: linear-gradient(180deg, #171b1f, #111417);
  box-shadow: 0 28rpx 56rpx rgba(0, 0, 0, 0.32);
}

.theme-dark .create-sheet__handle {
  background: rgba(255, 255, 255, 0.12);
}

.theme-dark .create-sheet__title {
  color: #f2f5f7;
}

.theme-dark .create-sheet__close {
  color: #8e99a3;
}

.theme-dark .create-sheet__option {
  background: #171b1f;
  color: #f2f5f7;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .create-sheet__option--active {
  background: #20262b;
}

.theme-dark .create-sheet__option-check {
  color: #b7dfbe;
}
