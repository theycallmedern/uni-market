<view class="page-shell create-page {{themeClass}}">
  <app-header title="{{navTitle}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="create-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="create-content">
      <view class="compose-hero">
      <view>
        <text class="compose-title">{{heroTitle}}</text>
        <text class="compose-copy">{{heroCopy}}</text>
      </view>
      <view class="compose-chip">{{heroChip}}</view>
      </view>

      <view class="form-card">
        <view class="card-head">
          <text class="card-title">Photos</text>
          <text class="card-hint">Up to {{photoLimit}} · first is cover</text>
        </view>
        <text class="card-subhint">Tap a photo to preview. Use arrows to reorder.</text>

        <scroll-view class="photo-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="photo-row">
            <view class="photo-add" bindtap="choosePhotos">
              <text class="photo-add__icon">+</text>
              <text class="photo-add__text">Add photo</text>
            </view>

            <block wx:for="{{form.images}}" wx:key="*this">
              <view class="photo-card">
                <image
                  class="photo-card__image"
                  src="{{item}}"
                  mode="aspectFill"
                  data-index="{{index}}"
                  bindtap="previewPhoto"
                />
                <view class="photo-card__badge {{index === 0 ? 'photo-card__badge--cover' : ''}}">
                  <text>{{index === 0 ? 'Cover' : index + 1}}</text>
                </view>
                <view class="photo-card__remove" data-index="{{index}}" catchtap="removePhoto">
                  <text class="photo-card__remove-icon">×</text>
                </view>
                <view class="photo-card__toolbar">
                  <button wx:if="{{index !== 0}}" class="photo-tool" data-index="{{index}}" data-direction="left" bindtap="movePhoto">
                    ←
                  </button>
                  <button
                    wx:if="{{index !== form.images.length - 1}}"
                    class="photo-tool"
                    data-index="{{index}}"
                    data-direction="right"
                    bindtap="movePhoto"
                  >
                    →
                  </button>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <view class="form-card">
        <view class="card-head">
          <text class="card-title">Basics</text>
          <text class="card-hint">What are you offering?</text>
        </view>

        <view class="field">
          <text class="field-label">Title</text>
          <input
            class="field-input"
            placeholder="Room near campus, iPhone 14, bike..."
            placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
            style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
            value="{{form.title}}"
            maxlength="70"
            data-field="title"
            bindinput="onFieldInput"
          />
        </view>

        <view class="field-row">
          <view class="field field-half">
            <text class="field-label">Price</text>
            <input
              class="field-input"
              placeholder="2800"
              placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
              style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
              value="{{form.price}}"
              type="number"
              maxlength="6"
              data-field="price"
              bindinput="onFieldInput"
            />
          </view>

          <view class="field field-half">
            <text class="field-label">Location</text>
            <view class="picker-field picker-field--locked">
              <text class="picker-field__locked-value">Hangzhou</text>
            </view>
          </view>
        </view>

        <view class="field">
          <text class="field-label">Address</text>
          <input
            class="field-input"
            placeholder="Xixi Campus, Yuhangtang Rd 866, Building 3"
            placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
            style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
            value="{{form.address}}"
            maxlength="120"
            data-field="address"
            bindinput="onFieldInput"
            bindblur="onAddressBlur"
          />
          <text wx:if="{{addressHintVisible}}" class="field-helper">{{addressHintText}}</text>
        </view>

        <view class="field-row">
          <view class="field field-half">
            <text class="field-label">Category</text>
            <view class="picker-field" data-field="category" bindtap="openCreateSheet">
              <text>{{categories[categoryIndex].name}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </view>

          <view class="field field-half">
            <text class="field-label">Subcategory</text>
            <view class="picker-field" data-field="subcategory" bindtap="openCreateSheet">
              <text>{{subcategoryOptions[subcategoryIndex]}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </view>
        </view>

        <view wx:if="{{isCustomSubcategory}}" class="field">
          <text class="field-label">Custom subcategory</text>
          <input
            class="field-input"
            placeholder="Type your own subcategory"
            placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
            style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
            value="{{customSubcategory}}"
            maxlength="40"
            bindinput="onCustomSubcategoryInput"
          />
        </view>

        <view wx:if="{{requiresCondition}}" class="field">
          <text class="field-label">Condition</text>
          <view class="picker-field" data-field="condition" bindtap="openCreateSheet">
            <text>{{conditionOptions[conditionIndex]}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </view>
      </view>

      <view class="form-card">
        <view class="card-head">
          <text class="card-title">Contact</text>
          <text class="card-hint">How should buyers find you?</text>
        </view>

        <view class="field">
          <text class="field-label">University</text>
          <view class="picker-field" data-field="university" bindtap="openCreateSheet">
            <text>{{universityOptions[universityIndex]}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </view>

        <view class="field">
          <text class="field-label">WeChat ID</text>
          <input
            class="field-input"
            placeholder="wechatid (6-20 chars)"
            placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
            style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
            value="{{form.wechat}}"
            maxlength="20"
            data-field="wechat"
            bindinput="onFieldInput"
          />
        </view>
      </view>

      <view class="form-card">
        <view class="card-head">
          <text class="card-title">Description</text>
          <text class="card-hint">Add condition, timing, pickup notes, or extras</text>
        </view>

        <textarea
          class="description-input"
          placeholder="Describe the item, service, or room in a way another student can trust quickly."
          placeholder-style="{{isDarkTheme ? 'color: #8e99a3;' : ''}}"
          style="{{isDarkTheme ? 'color: #f2f5f7;' : ''}}"
          value="{{form.description}}"
          data-field="description"
          bindinput="onFieldInput"
          maxlength="600"
        />
      </view>

      <view class="publish-inline">
        <button class="publish-button" loading="{{submitting}}" bindtap="submitListing">{{submitLabel}}</button>
      </view>

      <view wx:if="{{createSheetOpen}}" class="create-sheet-overlay" bindtap="closeCreateSheet">
        <view class="create-sheet" catchtap="stopCreateSheetTap">
          <view class="create-sheet__handle"></view>
          <view class="create-sheet__head">
            <text class="create-sheet__title">{{createSheetTitle}}</text>
            <text class="create-sheet__close" bindtap="closeCreateSheet">Cancel</text>
          </view>
          <scroll-view class="create-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{createSheetOptions}}"
              wx:key="index"
              class="create-sheet__option {{createSheetValue === index ? 'create-sheet__option--active' : ''}}"
              data-index="{{index}}"
              bindtap="onCreateSheetOptionTap"
            >
              <text class="create-sheet__option-label">{{item}}</text>
              <text wx:if="{{createSheetValue === index}}" class="create-sheet__option-check">✓</text>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
