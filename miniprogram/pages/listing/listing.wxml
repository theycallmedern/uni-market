<view wx:if="{{listing}}" class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="listing-page page-scroll__content">
      <view wx:if="{{hiddenNotice || soldNotice || archivedNotice}}" class="listing-status-card {{soldNotice ? 'listing-status-card--sold' : ''}}">
        <text class="listing-status-badge {{soldNotice ? 'listing-status-badge--sold' : (archivedNotice ? 'listing-status-badge--archived' : '')}}">
          {{soldNotice ? copy.soldBadge : (archivedNotice ? copy.archivedStatus : copy.hiddenBadge)}}
        </text>
        <text class="listing-status-copy">{{soldNotice || archivedNotice || hiddenNotice}}</text>
      </view>

  <view class="gallery-shell">
    <view class="listing-menu-trigger" bindtap="openMenu">
      <text class="listing-menu-trigger__icon">•••</text>
    </view>

    <swiper
      class="gallery-swiper"
      indicator-dots="{{false}}"
      circular
      bindchange="onSwiperChange"
    >
      <block wx:for="{{listing.images}}" wx:key="*this">
        <swiper-item>
          <image class="gallery-image" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewListingImage" />
        </swiper-item>
      </block>
    </swiper>

    <view class="gallery-counter">{{currentImage}} / {{listing.images.length}}</view>
  </view>

  <view class="listing-main-card">
    <text class="listing-price">{{listing.price}}</text>
    <text class="listing-title">{{listing.title}}</text>
    <view class="listing-meta-row">
      <text wx:if="{{listing.isPromoted}}" class="listing-chip listing-chip--promoted">{{listing.displayPromotedBadge}}</text>
      <text wx:if="{{listing.condition}}" class="listing-chip listing-chip--condition {{conditionChipClass}}">{{listing.displayCondition}}</text>
      <text class="listing-chip listing-chip--subcategory">{{listing.displaySubcategory}}</text>
      <text class="listing-chip listing-chip--location">{{listing.displayLocation}}</text>
    </view>
    <text class="listing-description">{{listing.description}}</text>
  </view>

  <view class="detail-grid">
    <view class="detail-card">
      <text class="detail-label">{{copy.locationLabel}}</text>
      <text class="detail-value">{{listing.displayLocation}}</text>
    </view>

    <view wx:if="{{listing.university}}" class="detail-card">
      <text class="detail-label">{{copy.universityLabel}}</text>
      <text class="detail-value">{{listing.university}}</text>
    </view>
  </view>

  <view wx:if="{{listing.address}}" class="listing-address-card">
    <view class="listing-address-card__head">
      <text class="listing-address-card__label">{{copy.addressLabel}}</text>
      <view class="listing-address-card__action" bindtap="copyAddress">
        <text class="listing-address-card__action-icon">⎘</text>
        <text>{{copy.copyAddress}}</text>
      </view>
    </view>
    <text class="listing-address-card__text">{{listing.address}}</text>
  </view>

  <view wx:if="{{showOwnerAnalytics && ownerListingAnalytics}}" class="listing-owner-analytics">
    <view class="listing-owner-analytics__head">
      <text class="listing-owner-analytics__title">{{copy.analyticsTitle}}</text>
      <text class="listing-owner-analytics__subtitle">{{copy.analyticsSubtitle}}</text>
    </view>
    <view class="listing-owner-analytics__grid">
      <view class="listing-owner-analytics__item">
        <text class="listing-owner-analytics__value">{{ownerListingAnalytics.views}}</text>
        <text class="listing-owner-analytics__label">{{copy.analyticsViews}}</text>
        <text class="listing-owner-analytics__trend">+{{ownerListingAnalytics.recentViews}} {{copy.thisWeekSuffix}}</text>
      </view>
      <view class="listing-owner-analytics__item">
        <text class="listing-owner-analytics__value">{{ownerListingAnalytics.saves}}</text>
        <text class="listing-owner-analytics__label">{{copy.analyticsSaved}}</text>
        <text class="listing-owner-analytics__trend">+{{ownerListingAnalytics.recentSaves}} {{copy.thisWeekSuffix}}</text>
      </view>
    </view>
  </view>

  <view class="seller-card" bindtap="openSellerProfile">
    <view class="seller-main">
      <view class="seller-header">
        <view class="seller-avatar" catchtap="previewSellerAvatar">
          <image wx:if="{{listing.seller.avatarUrl}}" class="seller-avatar__image" src="{{listing.seller.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{sellerInitial}}</text>
        </view>
        <view class="seller-identity">
          <text class="seller-name">{{listing.seller.name}}</text>
          <view wx:if="{{sellerMemberLabel}}" class="seller-member-badge">
            <view class="seller-member-badge__icon-wrap">
              <text class="seller-member-badge__icon">✦</text>
            </view>
            <text class="seller-member-badge__text">{{sellerMemberLabel}}</text>
          </view>
        </view>
      </view>

      <view class="seller-details">
        <view class="seller-rating">
          <text class="seller-rating__value {{sellerStatusClass}}">{{sellerStatusLabel}}</text>
          <text class="seller-rating__count">{{reviewSummary.count ? reviewSummary.averageLabel + ' ★ · ' + reviewSummary.countLabel : copy.noReviewsYet}}</text>
        </view>
        <text wx:if="{{sellerTrustLabel}}" class="seller-note">{{sellerTrustLabel}}</text>
        <text wx:if="{{listingPublishedLabel}}" class="seller-wechat">{{listingPublishedLabel}}</text>
      </view>
    </view>
    <text class="seller-arrow">›</text>
  </view>

  <view class="action-bar">
    <view class="action-button action-button--ghost {{isSaved ? 'action-button--ghost-saved' : ''}}" bindtap="toggleSave">
      <text class="action-button__icon">{{isSaved ? '♥' : '♡'}}</text>
      <text>{{isSaved ? copy.savedButton : copy.saveButton}}</text>
    </view>

    <view class="action-button action-button--primary {{listing.isSold ? 'action-button--disabled' : ''}}" bindtap="contactSeller">
      <view class="action-button__content action-button__content--wechat">
        <view wx:if="{{!listing.isSold}}" class="wechat-mark">
          <view class="wechat-mark__bubble wechat-mark__bubble--back">
            <view class="wechat-mark__tail wechat-mark__tail--back"></view>
            <view class="wechat-mark__dots wechat-mark__dots--back">
              <view class="wechat-mark__dot"></view>
              <view class="wechat-mark__dot"></view>
            </view>
          </view>
          <view class="wechat-mark__bubble wechat-mark__bubble--front">
            <view class="wechat-mark__tail wechat-mark__tail--front"></view>
            <view class="wechat-mark__dots wechat-mark__dots--front">
              <view class="wechat-mark__dot"></view>
              <view class="wechat-mark__dot"></view>
              <view class="wechat-mark__dot"></view>
            </view>
          </view>
        </view>
        <text>{{listing.isSold ? copy.soldBadge : copy.writeInWechatButton}}</text>
      </view>
    </view>
  </view>

      <view wx:if="{{feedbackVisible}}" class="save-feedback">
        <view class="save-feedback__icon">{{feedbackIcon}}</view>
        <text class="save-feedback__text">{{feedbackText}}</text>
      </view>

      <view wx:if="{{menuOpen}}" class="listing-menu-overlay" bindtap="closeMenu">
        <view class="listing-menu-sheet" catchtap="stopMenuTap">
          <view class="listing-menu-sheet__handle"></view>
          <view class="listing-menu-sheet__header">
            <text class="listing-menu-sheet__title">{{copy.listingOptionsTitle}}</text>
            <text class="listing-menu-sheet__subtitle">{{copy.listingOptionsSubtitle}}</text>
          </view>

          <view class="listing-menu-group">
            <view class="listing-menu-row-shell">
              <button class="listing-menu-hit" open-type="share" bindtap="closeMenu"></button>
              <view class="listing-menu-row">
                <view class="listing-menu-row__icon listing-menu-row__icon--share">↗</view>
                <view class="listing-menu-row__copy">
                  <text class="listing-menu-row__title">{{copy.shareListingTitle}}</text>
                  <text class="listing-menu-row__meta">{{copy.shareListingMeta}}</text>
                </view>
              </view>
            </view>

            <view class="listing-menu-row" bindtap="copyListingLink">
              <view class="listing-menu-row__icon listing-menu-row__icon--copy">⎘</view>
              <view class="listing-menu-row__copy">
                <text class="listing-menu-row__title">{{copy.copyLinkTitle}}</text>
                <text class="listing-menu-row__meta">{{copy.copyLinkMeta}}</text>
              </view>
            </view>

            <view wx:if="{{listing.seller.wechat}}" class="listing-menu-row" bindtap="copySellerWechat">
              <view class="listing-menu-row__icon listing-menu-row__icon--wechat">
                <view class="wechat-mark">
                  <view class="wechat-mark__bubble wechat-mark__bubble--back">
                    <view class="wechat-mark__tail wechat-mark__tail--back"></view>
                    <view class="wechat-mark__dots wechat-mark__dots--back">
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                    </view>
                  </view>
                  <view class="wechat-mark__bubble wechat-mark__bubble--front">
                    <view class="wechat-mark__tail wechat-mark__tail--front"></view>
                    <view class="wechat-mark__dots wechat-mark__dots--front">
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                    </view>
                  </view>
                </view>
              </view>
              <view class="listing-menu-row__copy">
                <text class="listing-menu-row__title">{{copy.writeInWechatTitle}}</text>
                <text class="listing-menu-row__meta">{{copy.writeInWechatMeta}}</text>
              </view>
            </view>

            <view class="listing-menu-row" bindtap="hideListing">
              <view class="listing-menu-row__icon listing-menu-row__icon--hide">×</view>
              <view class="listing-menu-row__copy">
                <text class="listing-menu-row__title">{{copy.hideListingTitle}}</text>
                <text class="listing-menu-row__meta">{{copy.hideListingMeta}}</text>
              </view>
            </view>

            <view class="listing-menu-row listing-menu-row--danger" bindtap="blockSeller">
              <view class="listing-menu-row__icon listing-menu-row__icon--block">−</view>
              <view class="listing-menu-row__copy">
                <text class="listing-menu-row__title">{{copy.blockUserTitle}}</text>
                <text class="listing-menu-row__meta">{{copy.blockUserMeta}}</text>
              </view>
            </view>
          </view>

          <view class="listing-menu-group listing-menu-group--danger">
            <view class="listing-menu-row listing-menu-row--danger" bindtap="reportListing">
              <view class="listing-menu-row__icon listing-menu-row__icon--report">!</view>
              <view class="listing-menu-row__copy">
                <text class="listing-menu-row__title">{{hasReported ? copy.reportSentTitle : copy.reportListingTitle}}</text>
                <text class="listing-menu-row__meta">{{hasReported ? copy.reportSentMeta : copy.reportListingMeta}}</text>
              </view>
            </view>
          </view>

          <view class="listing-menu-cancel" bindtap="closeMenu">{{copy.menuCancel}}</view>
        </view>
      </view>

      <photo-viewer
        visible="{{viewerVisible}}"
        images="{{viewerImages}}"
        currentIndex="{{viewerIndex}}"
        bind:close="closePhotoViewer"
        bind:change="onPhotoViewerChange"
      />
    </view>
  </scroll-view>
</view>

<view wx:elif="{{hiddenByUser}}" class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <view class="listing-empty-page">
    <view class="listing-empty-card">
      <text class="listing-empty-title">{{copy.emptyHiddenTitle}}</text>
      <text class="listing-empty-copy">{{copy.emptyHiddenCopy}}</text>
      <button class="listing-empty-button" bindtap="goToHome">
        <text class="listing-empty-button__icon">←</text>
        <text class="listing-empty-button__label">{{copy.backToListings}}</text>
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{blockedSeller}}" class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <view class="listing-empty-page">
    <view class="listing-empty-card">
      <text class="listing-empty-title">{{copy.emptySellerHiddenTitle}}</text>
      <text class="listing-empty-copy">{{copy.emptySellerHiddenCopy}}</text>
      <button class="listing-empty-button" bindtap="goToHome">
        <text class="listing-empty-button__icon">←</text>
        <text class="listing-empty-button__label">{{copy.backToListings}}</text>
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{blockedByModeration}}" class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <view class="listing-empty-page">
    <view class="listing-empty-card">
      <text class="listing-empty-title">{{copy.emptyUnavailableTitle}}</text>
      <text class="listing-empty-copy">{{copy.emptyUnavailableCopy}}</text>
      <button class="listing-empty-button" bindtap="goToHome">
        <text class="listing-empty-button__icon">←</text>
        <text class="listing-empty-button__label">{{copy.backToListings}}</text>
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{notFound}}" class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <view class="listing-empty-page">
    <view class="listing-empty-card">
      <text class="listing-empty-title">{{copy.emptyNotFoundTitle}}</text>
      <text class="listing-empty-copy">{{copy.emptyNotFoundCopy}}</text>
      <button class="listing-empty-button" bindtap="goToHome">
        <text class="listing-empty-button__icon">←</text>
        <text class="listing-empty-button__label">{{copy.backToListings}}</text>
      </button>
    </view>
  </view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
<feedback-action-sheet id="feedback-action-sheet" themeMode="{{themeMode}}"></feedback-action-sheet>
