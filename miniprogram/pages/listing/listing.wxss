.listing-page {
  padding: 20rpx 20rpx 180rpx;
}

.listing-status-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: #fff1f1;
}

.listing-status-badge {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ba2d2d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.listing-status-copy {
  font-size: 24rpx;
  line-height: 1.4;
  color: #8a3030;
}

.listing-status-card--sold {
  background: #eef8ef;
}

.listing-status-badge--sold {
  background: #2f7d32;
}

.listing-status-card--sold .listing-status-copy {
  color: #2f6c31;
}

.gallery-shell {
  position: relative;
}

.listing-menu-trigger {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.1);
}

.listing-menu-trigger__icon {
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #111111;
}

.gallery-swiper {
  height: 520rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ececec;
}

.gallery-image {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-counter {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.72);
  color: #ffffff;
  font-size: 22rpx;
}

.listing-main-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.04);
}

.listing-price {
  font-size: 40rpx;
  font-weight: 700;
}

.listing-title {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
}

.listing-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.listing-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f1ec;
  font-size: 22rpx;
  color: #5f5f5f;
  border: 1rpx solid rgba(17, 17, 17, 0.04);
}

.listing-chip--subcategory {
  background: #f1eef7;
  color: #5a4c78;
  border-color: rgba(90, 76, 120, 0.14);
}

.listing-chip--location {
  background: #eaf1fc;
  color: #315784;
  border-color: rgba(49, 87, 132, 0.14);
}

.listing-chip--condition {
  font-weight: 600;
}

.listing-chip--condition-new {
  background: #e7f6eb;
  color: #256b3d;
  border-color: rgba(37, 107, 61, 0.18);
}

.listing-chip--condition-like-new {
  background: #e9f6f1;
  color: #26645a;
  border-color: rgba(38, 100, 90, 0.16);
}

.listing-chip--condition-used {
  background: #f7f0de;
  color: #8c6322;
  border-color: rgba(140, 99, 34, 0.18);
}

.listing-chip--condition-refurbished {
  background: #e9f0fa;
  color: #2f5f95;
  border-color: rgba(47, 95, 149, 0.16);
}

.listing-chip--condition-parts {
  background: #fbe9e9;
  color: #9a3f3f;
  border-color: rgba(154, 63, 63, 0.16);
}

.listing-chip--condition-default {
  background: #efefef;
  color: #555555;
  border-color: rgba(17, 17, 17, 0.1);
}

.listing-description {
  font-size: 26rpx;
  line-height: 1.5;
  color: #4f4f4f;
}

.detail-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detail-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.detail-label {
  font-size: 22rpx;
  color: #888888;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 600;
}

.listing-address-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.04);
}

.listing-address-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.listing-address-card__label {
  font-size: 22rpx;
  color: #8a8a8a;
}

.listing-address-card__action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(79, 152, 232, 0.32);
  font-size: 22rpx;
  line-height: 1;
  color: #4f98e8;
  font-weight: 600;
}

.listing-address-card__action-icon {
  font-size: 22rpx;
  line-height: 1;
}

.listing-address-card__text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #1f1f1f;
}

.seller-card {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.seller-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 16rpx;
}

.seller-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.seller-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #d8e9ff, #f6ddd8);
  font-size: 36rpx;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}

.seller-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
}

.seller-identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.seller-name {
  font-size: 34rpx;
  line-height: 1.12;
  font-weight: 700;
}

.seller-badge {
  font-size: 22rpx;
  color: #2f7d32;
}

.seller-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.seller-rating {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.seller-rating__value {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fff2d9;
  font-size: 21rpx;
  font-weight: 700;
  color: #9a6611;
}

.seller-rating__count {
  font-size: 22rpx;
  color: #7b7b7b;
}

.seller-note,
.seller-wechat {
  font-size: 24rpx;
  color: #6f6f6f;
}

.seller-arrow {
  font-size: 42rpx;
  line-height: 1;
  color: #8d8d8d;
  flex-shrink: 0;
}

.action-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 40rpx rgba(17, 17, 17, 0.08);
  backdrop-filter: blur(18rpx);
}

.listing-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(17, 17, 17, 0.24);
  backdrop-filter: blur(8rpx);
}

.listing-menu-sheet {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 18rpx 18rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-radius: 36rpx;
  background: linear-gradient(180deg, #ffffff, #faf8f2);
  box-shadow: 0 28rpx 56rpx rgba(17, 17, 17, 0.16);
}

.listing-menu-sheet__handle {
  display: flex;
  align-self: center;
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.14);
}

.listing-menu-sheet__header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 6rpx 10rpx 0;
}

.listing-menu-sheet__title {
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #111111;
}

.listing-menu-sheet__subtitle {
  font-size: 23rpx;
  line-height: 1.45;
  color: #7b7b7b;
}

.listing-menu-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
}

.listing-menu-group--danger {
  background: rgba(255, 246, 245, 0.8);
}

.listing-menu-row-shell {
  position: relative;
  width: 100%;
}

.listing-menu-hit {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
}

.listing-menu-hit::after {
  border: 0;
}

.listing-menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  color: #111111;
  text-align: left;
  box-shadow: 0 10rpx 22rpx rgba(17, 17, 17, 0.04);
}

.listing-menu-row--danger {
  background: linear-gradient(180deg, #fff8f7, #fff1f0);
}

.listing-menu-row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
}

.listing-menu-row__icon--share {
  background: #eef4e7;
  color: #345f31;
}

.listing-menu-row__icon--report {
  background: #ffe2de;
  color: #ba2d2d;
}

.listing-menu-row__icon--copy {
  background: #eef1f5;
  color: #40556d;
}

.listing-menu-row__icon--wechat {
  background: #e6f3e7;
  color: #2f7d32;
}

.listing-menu-row__icon--hide {
  background: #f1eee8;
  color: #7c6f58;
}

.listing-menu-row__icon--block {
  background: #ffe9e6;
  color: #ba2d2d;
}

.listing-menu-row__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.listing-menu-row__title {
  font-size: 29rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #111111;
}

.listing-menu-row__meta {
  font-size: 22rpx;
  line-height: 1.35;
  color: #7a7a7a;
}

.listing-menu-row--danger .listing-menu-row__title {
  color: #8f2323;
}

.listing-menu-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(17, 17, 17, 0.06);
  color: #555555;
  font-size: 28rpx;
  font-weight: 700;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.action-button--ghost {
  width: 210rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  background: #ffffff;
  color: #2d2d2d;
}

.action-button--ghost-saved {
  background: #d32f2f;
  color: #ffffff;
  border-color: #d32f2f;
}

.action-button__icon {
  font-size: 28rpx;
}

.action-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.action-button--primary {
  flex: 1;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.action-button--disabled {
  background: #ece9e3;
  color: #9a9a9a;
  border-color: rgba(17, 17, 17, 0.06);
}

.wechat-mark {
  position: relative;
  width: 50rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.wechat-mark__bubble {
  position: absolute;
  border-radius: 999rpx;
  background: #07c160;
  box-shadow: 0 6rpx 14rpx rgba(7, 193, 96, 0.18);
}

.wechat-mark__bubble--back {
  top: 2rpx;
  right: 1rpx;
  width: 28rpx;
  height: 22rpx;
}

.wechat-mark__bubble--front {
  left: 0;
  bottom: 0;
  width: 34rpx;
  height: 26rpx;
}

.wechat-mark__tail {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #07c160;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.wechat-mark__tail--back {
  right: 5rpx;
  bottom: -2rpx;
}

.wechat-mark__tail--front {
  left: 6rpx;
  bottom: -2rpx;
}

.wechat-mark__dots {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.wechat-mark__dots--back {
  top: 8rpx;
  left: 7rpx;
}

.wechat-mark__dots--front {
  top: 10rpx;
  left: 7rpx;
}

.wechat-mark__dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.save-feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 28rpx;
  background: rgba(40, 40, 40, 0.86);
  color: #ffffff;
  transform: translate(-50%, -50%);
  animation: feedback-pop 220ms ease;
  z-index: 20;
}

.save-feedback__icon {
  font-size: 74rpx;
  line-height: 1;
}

.save-feedback__text {
  font-size: 26rpx;
  font-weight: 600;
}

.listing-empty-page {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.listing-empty-card {
  width: 100%;
  padding: 36rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.listing-empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.listing-empty-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f6f6f;
}

.listing-empty-button {
  margin-top: 20rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 28rpx;
  line-height: 92rpx;
  font-weight: 700;
}

.listing-empty-button::after {
  border: 0;
}

@keyframes feedback-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.92);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
