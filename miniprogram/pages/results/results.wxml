<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="results-page page-scroll__content">
      <view class="results-search-shell">
        <text class="results-search__icon">⌕</text>
        <input
          class="results-search__input"
          placeholder="Search within {{categoryTitle}}"
          value="{{search}}"
          bindinput="onSearchInput"
        />
      </view>

  <view class="results-heading">
    <text class="results-title">{{categoryTitle}}</text>
    <view class="results-meta-row">
      <text wx:if="{{activeSubcategoryLabel}}" class="results-subtitle">{{activeSubcategoryLabel}}</text>
      <text class="results-meta">{{visibleListings.length}} listings</text>
    </view>
  </view>

  <view class="results-controls">
    <view class="results-chip-row">
      <selector-sheet title="Sort" options="{{sortOptions}}" value="{{sortIndex}}" theme-mode="{{themeMode}}" bindchange="onSortChange">
        <view class="results-chip results-chip--dark">
          <text>{{sortOptions[sortIndex]}}</text>
          <text class="results-chip__arrow">⌄</text>
        </view>
      </selector-sheet>

      <selector-sheet title="Location" options="{{locationOptions}}" value="{{locationIndex}}" theme-mode="{{themeMode}}" bindchange="onLocationChange">
        <view class="results-chip">
          <text>{{locationOptions[locationIndex]}}</text>
          <text class="results-chip__arrow">⌄</text>
        </view>
      </selector-sheet>
    </view>

    <view class="results-chip-row">
      <selector-sheet title="University" options="{{universityOptions}}" value="{{universityIndex}}" theme-mode="{{themeMode}}" bindchange="onUniversityChange">
        <view class="results-chip results-chip--wide">
          <text>{{universityOptions[universityIndex]}}</text>
          <text class="results-chip__arrow">⌄</text>
        </view>
      </selector-sheet>

      <view class="results-clear" bindtap="clearFilters">Reset</view>
    </view>

    <view class="results-price-row">
      <input
        class="results-price-input"
        placeholder="Price from"
        type="number"
        value="{{priceMin}}"
        data-field="priceMin"
        bindinput="onPriceInput"
      />
      <input
        class="results-price-input"
        placeholder="Price to"
        type="number"
        value="{{priceMax}}"
        data-field="priceMax"
        bindinput="onPriceInput"
      />
    </view>
  </view>

  <view wx:if="{{visibleListings.length}}" class="results-list">
    <block wx:for="{{visibleListings}}" wx:key="id">
      <view class="result-card {{item.isPromoted ? 'result-card--promoted' : ''}}" data-id="{{item.id}}" bindtap="openListing">
        <view class="result-card__inner">
          <view class="result-card__media">
            <image class="result-card__image" src="{{item.image}}" mode="aspectFill" />
            <view wx:if="{{item.isPromoted}}" class="result-card__featured">✦ Promoted</view>
            <view wx:if="{{item.isSellerPro && !item.isPromoted}}" class="result-card__pro">Seller Pro</view>
            <view
              class="result-card__save {{item.isSaved ? 'result-card__save--saved' : ''}} {{pulseListingId === item.id ? 'result-card__save--pulse' : ''}}"
              data-id="{{item.id}}"
              catchtap="toggleSave"
            >
              <text class="result-card__save-icon">{{item.isSaved ? '♥' : '♡'}}</text>
            </view>
          </view>
          <view class="result-card__body">
            <view class="result-card__headline">
              <text class="result-card__price">{{item.price}}</text>
              <text class="result-card__tag">{{item.subcategory}}</text>
            </view>
            <text class="result-card__title">{{item.title}}</text>
            <text class="result-card__meta">{{item.university ? item.location + ' · ' + item.university : item.location}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:else class="results-empty">
    <text class="results-empty__title">No matching listings</text>
    <text class="results-empty__copy">Try a wider price range, another campus, or clear the filters.</text>
  </view>

      <view wx:if="{{feedbackVisible}}" class="save-feedback">
        <view class="save-feedback__icon">{{feedbackIcon}}</view>
        <text class="save-feedback__text">{{feedbackText}}</text>
      </view>
    </view>
  </scroll-view>
</view>
