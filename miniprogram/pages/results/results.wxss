.results-page {
  padding: 24rpx;
}

.results-search-shell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f1eee7;
}

.results-search__icon {
  font-size: 28rpx;
  color: #7d7d7d;
}

.results-search__input {
  flex: 1;
  font-size: 28rpx;
}

.results-heading {
  margin-top: 28rpx;
}

.results-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
}

.results-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.results-subtitle {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef5ec;
  color: #2f7d32;
  font-size: 22rpx;
  font-weight: 700;
}

.results-meta {
  font-size: 24rpx;
  color: #777777;
}

.results-controls {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.results-chip-row,
.results-price-row {
  display: flex;
  gap: 12rpx;
}

.results-chip-row + .results-chip-row,
.results-chip-row + .results-price-row {
  margin-top: 12rpx;
}

.results-chip,
.results-clear,
.results-price-input {
  box-sizing: border-box;
  min-height: 82rpx;
  border-radius: 24rpx;
  background: #f5f3ee;
}

.results-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
  padding: 0 22rpx;
  font-size: 26rpx;
  background: linear-gradient(180deg, #f1f1f1, #e6e6e6);
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  color: #2d2d2d;
}

.results-chip--dark {
  background: linear-gradient(180deg, #f1f1f1, #e6e6e6);
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.results-chip--wide {
  flex: 1.3;
}

.results-chip__arrow {
  font-size: 24rpx;
}

.results-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2d2d2d;
  background: linear-gradient(180deg, #f1f1f1, #e6e6e6);
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.results-price-input {
  flex: 1;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.result-card {
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.05);
}

.result-card__media {
  position: relative;
}

.result-card__image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #ececec;
}

.result-card__save {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 18rpx rgba(17, 17, 17, 0.08);
}

.result-card__save-icon {
  font-size: 28rpx;
  color: #181818;
}

.result-card__save--saved {
  background: rgba(211, 47, 47, 0.96);
}

.result-card__save--saved .result-card__save-icon {
  color: #ffffff;
}

.result-card__save--pulse {
  animation: heart-pop 320ms ease;
}

.result-card__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx;
}

.result-card__headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.result-card__price {
  font-size: 34rpx;
  font-weight: 700;
}

.result-card__tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f0e7;
  color: #6f6f6f;
  font-size: 22rpx;
}

.result-card__title {
  font-size: 30rpx;
  line-height: 1.3;
}

.result-card__meta {
  font-size: 24rpx;
  color: #7f7f7f;
}

.results-empty {
  margin-top: 28rpx;
  padding: 48rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  text-align: center;
}

.results-empty__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.results-empty__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d7d7d;
  line-height: 1.45;
}

.save-feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 28rpx;
  background: rgba(40, 40, 40, 0.86);
  color: #ffffff;
  transform: translate(-50%, -50%);
  animation: feedback-pop 220ms ease;
  z-index: 20;
}

.save-feedback__icon {
  font-size: 74rpx;
  line-height: 1;
}

.save-feedback__text {
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes heart-pop {
  0% {
    transform: scale(0.88);
  }

  60% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes feedback-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.92);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
