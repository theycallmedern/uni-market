<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="Profile" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="account-page page-scroll__content">
      <view class="account-hero">
        <view class="account-hero__top">
          <view class="account-avatar account-avatar--clickable" bindtap="openOwnPublicProfile">
            <image wx:if="{{profile.avatarUrl}}" class="account-avatar__image" src="{{profile.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{avatarInitial}}</text>
          </view>
          <view class="account-copy">
            <text class="account-eyebrow">Account hub</text>
            <view class="account-name-row">
              <text class="account-name">{{profile.name}}</text>
              <view wx:if="{{isSellerPro}}" class="account-pro-badge">
                <text class="account-pro-badge__icon">✦</text>
                <text class="account-pro-badge__text">Pro active</text>
              </view>
            </view>
          </view>
        </view>

        <view class="account-hero__body">
          <text class="account-note">Open your public profile to preview exactly what buyers see, then edit it there.</text>
          <view class="account-preview-pill" bindtap="openOwnPublicProfile">
            <text class="account-preview-hint">Tap avatar to open your public profile</text>
          </view>
        </view>
      </view>

  <view class="account-stats">
    <view class="account-stat">
      <text class="account-stat__value">{{myListingsCount}}</text>
      <text class="account-stat__label">Listings</text>
    </view>
    <view class="account-stat">
      <text class="account-stat__value">{{savedCount}}</text>
      <text class="account-stat__label">Saved</text>
    </view>
    <view class="account-stat">
      <text class="account-stat__value">{{soldCount}}</text>
      <text class="account-stat__label">Sold</text>
    </view>
  </view>

  <view class="account-section">
    <view class="account-section__head">
      <text class="account-section__title">Public profile</text>
      <text class="account-section__subtitle">Open the exact version buyers see, then edit it from there</text>
    </view>

      <view class="account-actions">
        <view class="account-action account-action--dark" bindtap="openOwnPublicProfile">
          <text class="account-action__title">Open my public profile</text>
          <text class="account-action__copy">Preview your profile exactly as other students see it and edit it there.</text>
        </view>

        <view class="account-action" bindtap="goToListings">
          <text class="account-action__title">Open my listings</text>
          <text class="account-action__copy">Check what is currently live under your seller profile.</text>
        </view>

        <view class="account-action" bindtap="openSettings">
          <view class="account-action__row">
            <text class="account-action__title">Settings</text>
            <text class="account-action__meta">Open</text>
          </view>
          <text class="account-action__copy">Admin access and extra account controls live on a separate page.</text>
        </view>

        <view class="account-action-pro-shell" bindtap="openSellerProOffer">
          <view class="account-action account-action--pro">
            <text class="account-action__title">✦ Upgrade to Seller Pro</text>
            <text class="account-action__copy">Your profile stands out more, gets better reach, and looks more trusted to buyers.</text>
            <text class="account-action__copy">Use advanced stats to see what performs best and publish smarter listings over time.</text>
            <text class="account-action__copy">79 RMB / month · 10 photos · custom badge · priority support.</text>
          </view>
        </view>
      </view>

  </view>

  <view class="account-section">
    <view class="account-section__head">
      <text class="account-section__title">About UniMarket</text>
      <text class="account-section__subtitle">What this MVP is optimized for right now</text>
    </view>

    <view class="account-info-card">
      <view class="account-info-card__glow"></view>
      <view class="account-info-card__brand">
        <view class="account-info-card__logo-wrap">
          <image class="account-info-card__logo" src="../../assets/brand/unimarket-logo.png" mode="aspectFit" />
        </view>
        <view class="account-info-card__brand-copy">
          <text class="account-info-card__brand-name">UniMarket</text>
          <text class="account-info-card__brand-note">Hangzhou student marketplace</text>
        </view>
        <view class="account-info-card__status">Student-first</view>
      </view>

      <text class="account-info-card__title">Built for student housing, resales, transport, and quick local help</text>
      <text class="account-info-card__copy">UniMarket keeps the flow simple inside WeChat so students can browse faster, post quicker, and connect with more trust inside one familiar campus marketplace.</text>

      <view class="account-info-card__highlights">
        <text class="account-info-card__highlight account-info-card__highlight--mint">WeChat Mini Program</text>
        <text class="account-info-card__highlight account-info-card__highlight--sky">Hangzhou MVP</text>
        <text class="account-info-card__highlight account-info-card__highlight--sand">Local-first demo data</text>
      </view>
    </view>
  </view>
    </view>
  </scroll-view>
</view>
