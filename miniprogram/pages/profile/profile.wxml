<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{copy.headerTitle}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="account-page page-scroll__content">
      <view class="account-hero">
        <view class="account-hero__top">
          <view class="account-avatar account-avatar--clickable" bindtap="openOwnPublicProfile">
            <image wx:if="{{profile.avatarUrl}}" class="account-avatar__image" src="{{profile.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{avatarInitial}}</text>
          </view>
          <view class="account-copy">
            <text class="account-eyebrow">{{copy.heroEyebrow}}</text>
            <view class="account-name-row">
              <text class="account-name">{{profile.name}}</text>
              <view wx:if="{{isSellerPro}}" class="account-pro-badge">
                <text class="account-pro-badge__icon">✦</text>
                <text class="account-pro-badge__text">{{copy.proActive}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="account-hero__body">
          <text class="account-note">{{copy.heroNote}}</text>
          <view class="account-preview-pill" bindtap="openOwnPublicProfile">
            <text class="account-preview-hint">{{copy.previewHint}}</text>
          </view>
        </view>
      </view>

  <view class="account-stats">
    <view class="account-stat">
      <text class="account-stat__value">{{myListingsCount}}</text>
      <text class="account-stat__label">{{copy.statsListings}}</text>
    </view>
    <view class="account-stat">
      <text class="account-stat__value">{{savedCount}}</text>
      <text class="account-stat__label">{{copy.statsSaved}}</text>
    </view>
    <view class="account-stat">
      <text class="account-stat__value">{{soldCount}}</text>
      <text class="account-stat__label">{{copy.statsSold}}</text>
    </view>
  </view>

  <view class="account-section">
    <view class="account-section__head">
      <text class="account-section__title">{{copy.publicProfileTitle}}</text>
      <text class="account-section__subtitle">{{copy.publicProfileSubtitle}}</text>
    </view>

      <view class="account-actions">
        <view class="account-action account-action--dark" bindtap="openOwnPublicProfile">
          <text class="account-action__title">{{copy.openPublicProfileTitle}}</text>
          <text class="account-action__copy">{{copy.openPublicProfileCopy}}</text>
        </view>

        <view class="account-action" bindtap="goToListings">
          <text class="account-action__title">{{copy.openListingsTitle}}</text>
          <text class="account-action__copy">{{copy.openListingsCopy}}</text>
        </view>

        <view class="account-action" bindtap="openSettings">
          <view class="account-action__row">
            <text class="account-action__title">{{copy.settingsTitle}}</text>
            <text class="account-action__meta">{{commonCopy.open}}</text>
          </view>
          <text class="account-action__copy">{{copy.settingsCopy}}</text>
        </view>

        <view class="account-action-pro-shell" bindtap="openSellerProOffer">
          <view class="account-action account-action--pro">
            <text class="account-action__title">{{copy.sellerProTitle}}</text>
            <text class="account-action__copy account-action__copy--lead">{{copy.sellerProLead}}</text>
            <view class="account-action__benefits">
              <view class="account-action__benefit">
                <text class="account-action__benefit-dot">•</text>
                <text class="account-action__benefit-copy">{{copy.sellerProBenefitOne}}</text>
              </view>
              <view class="account-action__benefit">
                <text class="account-action__benefit-dot">•</text>
                <text class="account-action__benefit-copy">{{copy.sellerProBenefitTwo}}</text>
              </view>
              <view class="account-action__benefit">
                <text class="account-action__benefit-dot">•</text>
                <text class="account-action__benefit-copy">{{copy.sellerProBenefitThree}}</text>
              </view>
            </view>
            <text class="account-action__offer">{{copy.sellerProOffer}}</text>
          </view>
        </view>
      </view>

  </view>

  <view class="account-section">
    <view class="account-section__head">
      <text class="account-section__title">{{copy.aboutTitle}}</text>
      <text class="account-section__subtitle">{{copy.aboutSubtitle}}</text>
    </view>

    <view class="account-info-card">
      <view class="account-info-card__glow"></view>
      <view class="account-info-card__brand">
        <view class="account-info-card__logo-wrap">
          <image class="account-info-card__logo" src="../../assets/brand/unimarket-logo.png" mode="aspectFit" />
        </view>
        <view class="account-info-card__brand-copy">
          <text class="account-info-card__brand-name">UniMarket</text>
          <text class="account-info-card__brand-note">{{copy.brandNote}}</text>
        </view>
        <view class="account-info-card__status">{{copy.brandStatus}}</view>
      </view>

      <text class="account-info-card__title">{{copy.aboutCardTitle}}</text>
      <text class="account-info-card__copy">{{copy.aboutCardCopy}}</text>

      <view class="account-info-card__highlights">
        <text class="account-info-card__highlight account-info-card__highlight--mint">{{copy.highlightOne}}</text>
        <text class="account-info-card__highlight account-info-card__highlight--sky">{{copy.highlightTwo}}</text>
        <text class="account-info-card__highlight account-info-card__highlight--sand">{{copy.highlightThree}}</text>
      </view>
    </view>
  </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
