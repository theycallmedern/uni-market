.account-page {
  padding: 22rpx 24rpx 172rpx;
}

.account-hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #eef4ea, #dbe7d3);
}

.account-hero__top {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.account-hero__body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.account-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.account-avatar--clickable {
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.08);
}

.account-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
}

.account-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.account-eyebrow {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #8a8a8a;
}

.account-name {
  display: block;
  font-size: 38rpx;
  line-height: 1.12;
  font-weight: 700;
}

.account-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.account-pro-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f1ebff;
  border: 1rpx solid rgba(106, 70, 179, 0.2);
  box-shadow: 0 8rpx 18rpx rgba(106, 70, 179, 0.08);
}

.account-pro-badge__icon {
  font-size: 20rpx;
  line-height: 1;
  color: #6a46b3;
}

.account-pro-badge__text {
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #6a46b3;
}

.account-note {
  display: block;
  font-size: 23rpx;
  line-height: 1.42;
  color: #707070;
}

.account-preview-pill {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(17, 17, 17, 0.04);
}

.account-preview-hint {
  display: block;
  font-size: 21rpx;
  line-height: 1.3;
  color: #8a8a8a;
}

.account-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.account-stat {
  flex: 1;
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.account-stat__value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.account-stat__label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7d7d7d;
}

.account-section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.account-section__head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-section__title {
  font-size: 34rpx;
  font-weight: 700;
}

.account-section__subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7d7d7d;
}

.account-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.account-action {
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
}

.account-action-pro-shell {
  padding: 2rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff6b6b, #ffd166, #7ed957, #4dabf7, #c77dff, #ff6b6b);
  box-shadow:
    0 12rpx 24rpx rgba(17, 17, 17, 0.05),
    0 0 24rpx rgba(124, 77, 255, 0.16);
}

.account-action--dark {
  background: linear-gradient(135deg, #ffffff, #f4f5f7);
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.05);
}

.account-action--pro {
  border-radius: 24rpx;
  background: #ffffff;
  border: 0;
}

.account-action--alert {
  background: #fff1f1;
  color: #7a1f1f;
}

.account-action--ghost {
  background: #f4f5f7;
}

.account-action__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.account-action__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.account-action__meta {
  flex-shrink: 0;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #8a8a8a;
}

.account-action__copy {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #6e6e6e;
}

.account-action__copy--lead {
  margin-top: 10rpx;
}

.account-action__benefits {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 14rpx;
}

.account-action__benefit {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.account-action__benefit-dot {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #4f8f50;
}

.account-action__benefit-copy {
  display: block;
  font-size: 24rpx;
  line-height: 1.42;
  color: #6e6e6e;
}

.account-action__offer {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(126, 217, 87, 0.12);
  color: #2f7a32;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 700;
}

.account-action--dark .account-action__copy {
  color: #666666;
}

.account-action--alert .account-action__copy {
  color: #8c3c3c;
}

.profile-view {
  margin-top: 20rpx;
}

.profile-row {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0efec;
}

.profile-row--bio {
  align-items: flex-start;
}

.profile-row--bio .profile-row__value {
  text-align: left;
}

.profile-row__label {
  font-size: 24rpx;
  color: #7b7b7b;
}

.profile-row__value {
  max-width: 420rpx;
  font-size: 24rpx;
  color: #222222;
  text-align: right;
  line-height: 1.4;
}

.profile-edit {
  width: 100%;
  margin-top: 18rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.profile-edit::after {
  border: 0;
}

.profile-form {
  margin-top: 20rpx;
}

.profile-avatar-editor {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.profile-avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-avatar-preview__image {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-avatar-editor__actions {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 10rpx;
}

.profile-avatar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  padding: 0 16rpx;
}

.profile-avatar-btn::after {
  border: 0;
}

.profile-avatar-btn--primary {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-avatar-btn--ghost {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-field {
  margin-bottom: 14rpx;
}

.profile-field:last-child {
  margin-bottom: 0;
}

.profile-field__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #7b7b7b;
}

.profile-field__input,
.profile-field__textarea,
.profile-field__picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f5f3ee;
  color: #111111;
}

.profile-field__input {
  height: 84rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.profile-field__picker {
  min-height: 84rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-picker__arrow {
  font-size: 28rpx;
  color: #6f6f6f;
}

.profile-field__textarea {
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.profile-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.profile-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
  padding: 0;
}

.profile-btn::after {
  border: 0;
}

.profile-btn--ghost {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-btn--primary {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.account-info-card {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #f7fbf4, #edf5e8 58%, #f8fbf6);
  border: 1rpx solid rgba(188, 204, 176, 0.72);
  box-shadow: 0 18rpx 36rpx rgba(17, 17, 17, 0.05);
}

.account-info-card__glow {
  position: absolute;
  top: -70rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(160, 214, 175, 0.26) 0%, rgba(160, 214, 175, 0.08) 42%, rgba(160, 214, 175, 0) 72%);
  pointer-events: none;
}

.account-info-card__brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.account-info-card__logo-wrap {
  width: 118rpx;
  height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.account-info-card__logo {
  width: 100%;
  height: 100%;
  display: block;
}

.account-info-card__brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
  justify-content: center;
}

.account-info-card__brand-name {
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #213321;
}

.account-info-card__brand-note {
  font-size: 19rpx;
  line-height: 1.3;
  color: #61735f;
}

.account-info-card__status {
  align-self: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(62, 102, 63, 0.12);
  font-size: 19rpx;
  line-height: 1;
  font-weight: 700;
  color: #315534;
  box-shadow: 0 10rpx 18rpx rgba(17, 17, 17, 0.04);
  flex-shrink: 0;
}

.account-info-card__title {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #1f2b1f;
}

.account-info-card__copy {
  display: block;
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #5d6d5d;
}

.account-info-card__highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  position: relative;
  z-index: 1;
}

.account-info-card__highlight {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.account-info-card__highlight--mint {
  background: #e9f5e8;
  color: #2d6230;
  border-color: rgba(45, 98, 48, 0.14);
}

.account-info-card__highlight--sky {
  background: #e8f0fb;
  color: #315784;
  border-color: rgba(49, 87, 132, 0.14);
}

.account-info-card__highlight--sand {
  background: #f4eee2;
  color: #7a6330;
  border-color: rgba(122, 99, 48, 0.14);
}

.account-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f3ee;
  font-size: 22rpx;
  color: #666666;
}

.theme-dark .account-hero {
  background: linear-gradient(135deg, #171c20, #111417);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.24);
}

.theme-dark .account-eyebrow,
.theme-dark .account-preview-hint,
.theme-dark .account-action__meta {
  color: #8e99a3;
}

.theme-dark .account-name,
.theme-dark .account-stat__value,
.theme-dark .account-section__title,
.theme-dark .account-action__title,
.theme-dark .account-info-card__title,
.theme-dark .account-info-card__brand-name {
  color: #f2f5f7;
}

.theme-dark .account-note,
.theme-dark .account-section__subtitle,
.theme-dark .account-action__copy,
.theme-dark .account-action__benefit-copy,
.theme-dark .account-info-card__copy,
.theme-dark .account-info-card__brand-note,
.theme-dark .account-stat__label {
  color: #8e99a3;
}

.theme-dark .account-action__benefit-dot {
  color: #93d98b;
}

.theme-dark .account-action__offer {
  background: rgba(126, 217, 87, 0.16);
  color: #b8efb0;
}

.theme-dark .account-preview-pill {
  background: rgba(35, 41, 46, 0.88);
  border-color: rgba(255, 255, 255, 0.05);
}

.theme-dark .account-pro-badge {
  background: linear-gradient(135deg, rgba(88, 62, 156, 0.34), rgba(48, 35, 88, 0.76));
  border-color: rgba(170, 142, 240, 0.18);
  box-shadow: 0 10rpx 22rpx rgba(34, 20, 68, 0.28);
}

.theme-dark .account-pro-badge__icon {
  color: #cdbbfb;
}

.theme-dark .account-pro-badge__text {
  color: #ddd0ff;
}

.theme-dark .account-stat,
.theme-dark .account-section,
.theme-dark .account-action,
.theme-dark .account-action--pro {
  background: #171b1f;
  border-color: rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .account-action--dark {
  background: linear-gradient(135deg, #1b2025, #171b1f);
  border-color: rgba(255, 255, 255, 0.06);
}

.theme-dark .account-info-card {
  background: linear-gradient(145deg, #171c20, #12161a 58%, #101316);
  border-color: rgba(255, 255, 255, 0.06);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .account-info-card__glow {
  background: radial-gradient(circle, rgba(80, 140, 106, 0.26) 0%, rgba(80, 140, 106, 0.1) 42%, rgba(80, 140, 106, 0) 72%);
}

.theme-dark .account-info-card__status {
  background: rgba(28, 34, 39, 0.92);
  border-color: rgba(255, 255, 255, 0.06);
  color: #c2d4c5;
}

.theme-dark .account-info-card__highlight--mint {
  background: rgba(54, 88, 60, 0.3);
  color: #b7dfbe;
  border-color: rgba(111, 167, 121, 0.16);
}

.theme-dark .account-info-card__highlight--sky {
  background: rgba(49, 87, 132, 0.24);
  color: #bad2ee;
  border-color: rgba(104, 150, 205, 0.18);
}

.theme-dark .account-info-card__highlight--sand {
  background: rgba(122, 99, 48, 0.22);
  color: #e0cfab;
  border-color: rgba(174, 145, 84, 0.18);
}
