.profile-page {
  padding: 22rpx 24rpx 44rpx;
}

.profile-hero {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #f4f8ee, #eef5ec);
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
}

.profile-meta {
  font-size: 24rpx;
  color: #4f704f;
}

.profile-note {
  font-size: 24rpx;
  line-height: 1.45;
  color: #707070;
}

.stats-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7d7d7d;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7d7d7d;
}

.post-link {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #111111;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.post-link::after,
.ghost-button::after,
.danger-button::after,
.empty-card__button::after {
  border: 0;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.profile-card {
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.profile-card__image {
  width: 100%;
  height: 260rpx;
  display: block;
  background: #ececec;
}

.profile-card__body {
  padding: 22rpx;
}

.profile-card__top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.profile-card__price {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-card__title {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
}

.profile-card__badge {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  background: #eef5ec;
  color: #2f7d32;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-card__meta,
.profile-card__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7b7b7b;
}

.profile-card__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ghost-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 76rpx;
  padding: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  text-align: center;
}

.ghost-button {
  background: #f5f3ee;
  color: #111111;
}

.danger-button {
  background: #fff1f1;
  color: #ba2d2d;
}

.empty-card {
  margin-top: 8rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.empty-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-card__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #7b7b7b;
}

.empty-card__button {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 80rpx;
  font-weight: 700;
}
