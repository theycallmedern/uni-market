.account-page {
  padding: 22rpx 24rpx 172rpx;
}

.account-hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #f4f8ee, #eef5ec);
}

.account-hero__top {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.account-hero__body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.account-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.account-avatar--clickable {
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.08);
}

.account-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
}

.account-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.account-eyebrow {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #8a8a8a;
}

.account-name {
  display: block;
  font-size: 38rpx;
  line-height: 1.12;
  font-weight: 700;
}

.account-note {
  display: block;
  font-size: 23rpx;
  line-height: 1.42;
  color: #707070;
}

.account-preview-pill {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(17, 17, 17, 0.04);
}

.account-preview-hint {
  display: block;
  font-size: 21rpx;
  line-height: 1.3;
  color: #8a8a8a;
}

.account-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.account-stat {
  flex: 1;
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.account-stat__value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.account-stat__label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7d7d7d;
}

.account-section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.account-section__head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-section__title {
  font-size: 34rpx;
  font-weight: 700;
}

.account-section__subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7d7d7d;
}

.account-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.account-action {
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
}

.account-action--dark {
  background: linear-gradient(135deg, #ffffff, #f4f5f7);
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.05);
}

.account-action--alert {
  background: #fff1f1;
  color: #7a1f1f;
}

.account-action--ghost {
  background: #f4f5f7;
}

.account-action__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.account-action__copy {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #6e6e6e;
}

.account-action--dark .account-action__copy {
  color: #666666;
}

.account-action--alert .account-action__copy {
  color: #8c3c3c;
}

.profile-view {
  margin-top: 20rpx;
}

.profile-row {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0efec;
}

.profile-row--bio {
  align-items: flex-start;
}

.profile-row--bio .profile-row__value {
  text-align: left;
}

.profile-row__label {
  font-size: 24rpx;
  color: #7b7b7b;
}

.profile-row__value {
  max-width: 420rpx;
  font-size: 24rpx;
  color: #222222;
  text-align: right;
  line-height: 1.4;
}

.profile-edit {
  width: 100%;
  margin-top: 18rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.profile-edit::after {
  border: 0;
}

.profile-form {
  margin-top: 20rpx;
}

.profile-avatar-editor {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.profile-avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-avatar-preview__image {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-avatar-editor__actions {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 10rpx;
}

.profile-avatar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  padding: 0 16rpx;
}

.profile-avatar-btn::after {
  border: 0;
}

.profile-avatar-btn--primary {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-avatar-btn--ghost {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-field {
  margin-bottom: 14rpx;
}

.profile-field:last-child {
  margin-bottom: 0;
}

.profile-field__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #7b7b7b;
}

.profile-field__input,
.profile-field__textarea,
.profile-field__picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f5f3ee;
  color: #111111;
}

.profile-field__input {
  height: 84rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.profile-field__picker {
  min-height: 84rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-picker__arrow {
  font-size: 28rpx;
  color: #6f6f6f;
}

.profile-field__textarea {
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.profile-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.profile-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
  padding: 0;
}

.profile-btn::after {
  border: 0;
}

.profile-btn--ghost {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.profile-btn--primary {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.account-info-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #f6f9f2, #edf3e5);
  border: 1rpx solid #e3ead8;
}

.account-info-card__brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.account-info-card__logo-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(17, 17, 17, 0.08);
}

.account-info-card__logo {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.account-info-card__brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.account-info-card__brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c3a2c;
}

.account-info-card__brand-note {
  font-size: 20rpx;
  color: #6e7d67;
}

.account-info-card__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
}

.account-info-card__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5f6f5f;
}

.account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.account-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f3ee;
  font-size: 22rpx;
  color: #666666;
}

.account-admin {
  margin-top: 20rpx;
  padding: 0 6rpx;
}

.account-admin__label {
  display: block;
  margin-bottom: 10rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #8b8b8b;
}

.account-admin__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  margin-bottom: 10rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  padding: 0 22rpx;
}

.account-admin__button:last-child {
  margin-bottom: 0;
}

.account-admin__button::after {
  border: 0;
}

.account-admin__button--primary {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.account-admin__button--alert {
  background: #fff1f1;
  color: #8a2525;
}

.account-admin__button--ghost {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}
