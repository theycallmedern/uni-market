<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="Moderation" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="moderation-page page-scroll__content">
      <view class="moderation-hero">
        <view class="moderation-hero__copy">
          <text class="moderation-hero__title">Moderation</text>
          <text class="moderation-hero__meta">
            {{summary.pending}} report pending · {{pendingPromotionCount}} promotion pending · {{pendingSellerProCount}} Seller Pro pending
          </text>
          <text class="moderation-hero__note">Review reports, promotion requests, and Seller Pro requests, then approve or reject.</text>
        </view>
      </view>

      <view wx:if="{{!isAdmin}}" class="moderation-locked">
        <text class="moderation-locked__title">Admin access required</text>
        <text class="moderation-locked__copy">Ask an admin for an access code to unlock moderation tools.</text>
      </view>

      <view wx:if="{{isAdmin}}" class="moderation-pro">
        <view class="moderation-pro__copy">
          <text class="moderation-pro__title">Seller Pro access</text>
          <text class="moderation-pro__meta">{{sellerProCount}} active Pro seller{{sellerProCount === 1 ? '' : 's'}}</text>
        </view>
        <button class="moderation-pro__button" bindtap="grantSellerProByNickname">Grant by nickname</button>
      </view>

      <view wx:if="{{isAdmin && sellerProSubscriptions.length}}" class="moderation-list">
        <text class="moderation-section-title">Active Seller Pro</text>
        <block wx:for="{{sellerProSubscriptions}}" wx:key="id">
          <view class="report-card">
            <view class="report-card__head">
              <view class="report-card__head-copy">
                <text class="report-card__title">{{item.nickname || item.wechat || 'Seller Pro user'}}</text>
                <text class="report-card__type">Seller Pro</text>
              </view>
              <text class="report-status report-status--dismissed">Active</text>
            </view>

            <text wx:if="{{item.wechat}}" class="report-card__meta">WeChat: {{item.wechat}}</text>
            <text wx:if="{{item.sellerKey}}" class="report-card__meta">Seller key: {{item.sellerKey}}</text>
            <text class="report-card__meta">Granted: {{item.grantedLabel}}</text>
            <text class="report-card__meta">Expires: {{item.expiresLabel}}</text>

            <view class="report-card__actions">
              <button class="report-action report-action--reject" data-id="{{item.id}}" bindtap="revokeSellerPro">Remove</button>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{isAdmin && sellerProRequests.length}}" class="moderation-list">
        <text class="moderation-section-title">Seller Pro requests</text>
        <block wx:for="{{sellerProRequests}}" wx:key="id">
          <view class="report-card">
            <view class="report-card__head">
              <view class="report-card__head-copy">
                <text class="report-card__title">{{item.nickname || item.wechat || 'Seller Pro request'}}</text>
                <text class="report-card__type">Seller Pro</text>
              </view>
              <text class="report-status report-status--pending">Pending</text>
            </view>

            <text wx:if="{{item.wechat}}" class="report-card__meta">WeChat: {{item.wechat}}</text>
            <text wx:if="{{item.sellerKey}}" class="report-card__meta">Seller key: {{item.sellerKey}}</text>
            <text class="report-card__time">{{item.createdLabel}}</text>

            <view class="report-card__actions">
              <button class="report-action report-action--approve" data-id="{{item.id}}" bindtap="approveSellerProRequest">Approve</button>
              <button class="report-action report-action--reject" data-id="{{item.id}}" bindtap="rejectSellerProRequest">Reject</button>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{isAdmin && !activeReports.length && !archivedReports.length && !promotionRequests.length && !sellerProRequests.length && !sellerProSubscriptions.length}}" class="moderation-empty">
        <text class="moderation-empty__title">No reports yet</text>
        <text class="moderation-empty__copy">Reports, promotion requests, and Seller Pro requests will appear here.</text>
      </view>

      <view wx:if="{{isAdmin && promotionRequests.length}}" class="moderation-list">
        <text class="moderation-section-title">Promotion requests</text>
        <block wx:for="{{promotionRequests}}" wx:key="id">
          <view class="report-card">
            <view class="report-card__head">
              <view class="report-card__head-copy">
                <text class="report-card__title">{{item.listingTitle}}</text>
                <text class="report-card__type">Promotion</text>
              </view>
              <text class="report-status report-status--pending">Pending</text>
            </view>

            <text class="report-card__meta">Listing ID: {{item.listingId}}</text>
            <text class="report-card__meta">Plan: {{item.planLabel}} · {{item.priceLabel}}</text>
            <text class="report-card__meta">Seller: {{item.sellerName}} · WeChat: {{item.sellerWechat}}</text>
            <text wx:if="{{item.isSellerPro}}" class="report-card__meta">Priority: Seller Pro</text>
            <text class="report-card__time">{{item.createdLabel}}</text>

            <view class="report-card__actions">
              <button class="report-action report-action--approve" data-id="{{item.id}}" bindtap="approvePromotionRequest">Approve</button>
              <button class="report-action report-action--reject" data-id="{{item.id}}" bindtap="rejectPromotionRequest">Reject</button>
              <button class="report-action report-action--ghost" data-id="{{item.listingId}}" bindtap="openListing">Open listing</button>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{isAdmin && activeReports.length}}" class="moderation-list">
        <text class="moderation-section-title">Reports</text>
        <block wx:for="{{activeReports}}" wx:key="id">
          <view class="report-card">
            <view class="report-card__head">
              <view class="report-card__head-copy">
                <text class="report-card__title">{{item.targetTitle}}</text>
                <text class="report-card__type">{{item.targetTypeLabel}}</text>
              </view>
              <text class="report-status report-status--{{item.status}}">{{item.statusLabel}}</text>
            </view>

            <text wx:if="{{item.targetType === 'listing'}}" class="report-card__meta">Listing ID: {{item.listingId}}</text>
            <text wx:if="{{item.targetType === 'profile'}}" class="report-card__meta">Profile key: {{item.profileKey}}</text>
            <text class="report-card__meta">Reason: {{item.reason}}</text>
            <text wx:if="{{item.note}}" class="report-card__note">Note: {{item.note}}</text>
            <text class="report-card__time">{{item.createdLabel}}</text>

            <view class="report-card__actions">
              <button class="report-action" data-id="{{item.id}}" bindtap="openStatusSheet">Update status</button>
              <button wx:if="{{item.targetType === 'listing'}}" class="report-action report-action--ghost" data-id="{{item.listingId}}" bindtap="openListing">Open listing</button>
              <button wx:if="{{item.targetType === 'profile' && item.sourceListingId}}" class="report-action report-action--ghost" data-id="{{item.sourceListingId}}" bindtap="openProfile">Open profile</button>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{isAdmin && archivedReports.length}}" class="moderation-list">
        <view class="moderation-archive-toggle" bindtap="toggleReportsArchive">
          <view class="moderation-archive-toggle__copy">
            <text class="moderation-section-title">Report archive</text>
            <text class="moderation-archive-toggle__meta">{{archivedReports.length}} processed report{{archivedReports.length === 1 ? '' : 's'}}</text>
          </view>
          <text class="moderation-archive-toggle__chevron">{{reportsArchiveOpen ? '⌃' : '⌄'}}</text>
        </view>

        <view wx:if="{{reportsArchiveOpen}}" class="moderation-archive-list">
          <block wx:for="{{archivedReports}}" wx:key="id">
            <view class="report-card">
              <view class="report-card__head">
                <view class="report-card__head-copy">
                  <text class="report-card__title">{{item.targetTitle}}</text>
                  <text class="report-card__type">{{item.targetTypeLabel}}</text>
                </view>
                <text class="report-status report-status--{{item.status}}">{{item.statusLabel}}</text>
              </view>

              <text wx:if="{{item.targetType === 'listing'}}" class="report-card__meta">Listing ID: {{item.listingId}}</text>
              <text wx:if="{{item.targetType === 'profile'}}" class="report-card__meta">Profile key: {{item.profileKey}}</text>
              <text class="report-card__meta">Reason: {{item.reason}}</text>
              <text wx:if="{{item.note}}" class="report-card__note">Note: {{item.note}}</text>
              <text class="report-card__time">{{item.createdLabel}}</text>

              <view class="report-card__actions">
                <button class="report-action" data-id="{{item.id}}" bindtap="openStatusSheet">Update status</button>
                <button wx:if="{{item.targetType === 'listing'}}" class="report-action report-action--ghost" data-id="{{item.listingId}}" bindtap="openListing">Open listing</button>
                <button wx:if="{{item.targetType === 'profile' && item.sourceListingId}}" class="report-action report-action--ghost" data-id="{{item.sourceListingId}}" bindtap="openProfile">Open profile</button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
<feedback-action-sheet id="feedback-action-sheet" themeMode="{{themeMode}}"></feedback-action-sheet>
