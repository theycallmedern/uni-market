<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{navTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{seller}}" class="user-page page-scroll__content">
      <view class="user-hero">
        <view class="user-hero__top">
          <view class="user-avatar" bindtap="previewAvatar">
            <image wx:if="{{seller.avatarUrl}}" class="user-avatar__image" src="{{seller.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{avatarInitial}}</text>
          </view>

          <view class="user-hero__main">
            <view class="user-hero__head">
              <text class="user-name">{{seller.name}}</text>
              <view class="user-menu-trigger" bindtap="openMenu">
                <text class="user-menu-trigger__icon">•••</text>
              </view>
            </view>
            <text wx:if="{{seller.wechat}}" class="user-wechat user-wechat--hero">{{copy.wechatLabel}}: {{seller.wechat}}</text>
          </view>
        </view>

        <view
          wx:if="{{seller.founderBadge || seller.badge || isUniversityPublic || reviewSummary.count || seller.city || memberSinceChipLabel}}"
          class="user-meta-stack"
        >
          <view class="user-meta-chips user-meta-chips--flow">
            <view wx:if="{{seller.founderBadge}}" class="user-meta-chip user-meta-chip--founder">
              <text class="user-meta-chip__icon">✦</text>
              <text>{{seller.displayFounderBadge}}</text>
            </view>
            <view wx:if="{{seller.founderInstagram}}" class="user-social-pill user-social-pill--instagram" bindtap="copyFounderInstagram">
              <view class="instagram-mark">
                <view class="instagram-mark__lens"></view>
                <view class="instagram-mark__dot"></view>
              </view>
                <text class="user-social-pill__label">{{seller.founderInstagramLabel}}</text>
            </view>
            <view
              wx:if="{{seller.badge}}"
              class="user-meta-chip user-meta-chip--badge {{seller.badge === 'Seller Pro' ? 'user-meta-chip--badge-pro' : 'user-meta-chip--badge-default'}}"
            >
              {{seller.displayBadge}}
            </view>
            <view wx:if="{{isUniversityPublic}}" class="user-meta-chip user-meta-chip--campus">{{seller.campus}}</view>
            <view wx:if="{{reviewSummary.count}}" class="user-meta-chip user-meta-chip--rating">★ {{reviewSummary.averageLabel}}</view>
            <view wx:if="{{seller.city}}" class="user-meta-chip user-meta-chip--city">{{seller.displayCity}}</view>
            <view wx:if="{{memberSinceChipLabel}}" class="user-meta-chip user-meta-chip--since">
              <text class="user-meta-chip__icon">✦</text>
              <text>{{memberSinceChipLabel}}</text>
            </view>
          </view>
        </view>

        <view class="user-copy user-copy--full">
          <text wx:if="{{seller.bio}}" class="user-note">{{seller.bio}}</text>
          <text wx:elif="{{seller.note}}" class="user-note">{{seller.note}}</text>
        </view>
      </view>

      <view class="user-stats">
        <view class="user-stat">
          <text class="user-stat__value">{{reviewSummary.count ? reviewSummary.averageLabel : copy.statsNew}}</text>
          <text class="user-stat__label">{{copy.statsRating}}</text>
        </view>
        <view class="user-stat">
          <text class="user-stat__value">{{listings.length}}</text>
          <text class="user-stat__label">{{copy.statsListings}}</text>
        </view>
        <view class="user-stat">
          <text class="user-stat__value">{{soldCount}}</text>
          <text class="user-stat__label">{{copy.statsSold}}</text>
        </view>
      </view>

      <view wx:if="{{isOwnProfile && seller.isSellerPro && seller.analytics}}" class="user-pro-analytics">
        <view class="user-pro-analytics__head">
          <text class="user-pro-analytics__title">{{copy.analyticsTitle}}</text>
          <text class="user-pro-analytics__subtitle">{{copy.analyticsSubtitle}}</text>
        </view>
        <view class="user-pro-analytics__grid">
          <view class="user-pro-analytics__item">
            <text class="user-pro-analytics__value">{{seller.analytics.profileViews}}</text>
            <text class="user-pro-analytics__label">{{copy.analyticsProfileViews}}</text>
            <text class="user-pro-analytics__trend">+{{seller.analytics.recentProfileViews}} {{copy.thisWeekSuffix}}</text>
          </view>
          <view class="user-pro-analytics__item">
            <text class="user-pro-analytics__value">{{seller.analytics.listingSaves}}</text>
            <text class="user-pro-analytics__label">{{copy.analyticsListingSaves}}</text>
            <text class="user-pro-analytics__trend">+{{seller.analytics.recentListingSaves}} {{copy.thisWeekSuffix}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{isOwnProfile}}" class="user-actions">
        <button wx:if="{{!isEditingProfile}}" class="user-contact" bindtap="startEditProfile">{{copy.editProfileButton}}</button>
      </view>

      <view wx:elif="{{seller.wechat}}" class="user-actions">
        <button class="user-contact" bindtap="contactSeller">
          <view class="user-contact__content">
            <view class="wechat-mark">
              <view class="wechat-mark__bubble wechat-mark__bubble--back">
                <view class="wechat-mark__tail wechat-mark__tail--back"></view>
                <view class="wechat-mark__dots wechat-mark__dots--back">
                  <view class="wechat-mark__dot"></view>
                  <view class="wechat-mark__dot"></view>
                </view>
              </view>
              <view class="wechat-mark__bubble wechat-mark__bubble--front">
                <view class="wechat-mark__tail wechat-mark__tail--front"></view>
                <view class="wechat-mark__dots wechat-mark__dots--front">
                  <view class="wechat-mark__dot"></view>
                  <view class="wechat-mark__dot"></view>
                  <view class="wechat-mark__dot"></view>
                </view>
              </view>
            </view>
            <text>{{copy.contactSellerButton}}</text>
          </view>
        </button>
        <button class="user-review-btn {{!canLeaveReview || hasReviewedCurrentListing ? 'user-review-btn--disabled' : ''}}" bindtap="leaveReview">
          {{hasReviewedCurrentListing ? copy.reviewedButton : copy.leaveReviewButton}}
        </button>
      </view>

      <view wx:if="{{isOwnProfile && isEditingProfile}}" class="user-section">
        <view class="user-section__head">
          <text class="user-section__title">{{copy.editSectionTitle}}</text>
          <text class="user-section__subtitle">{{copy.editSectionSubtitle}}</text>
        </view>

        <view class="profile-form profile-form--inline">
          <view class="profile-avatar-editor">
            <view class="profile-avatar-preview">
              <image wx:if="{{profileDraft.avatarUrl}}" class="profile-avatar-preview__image" src="{{profileDraft.avatarUrl}}" mode="aspectFill" />
              <text wx:else>{{avatarInitial}}</text>
            </view>
            <view class="profile-avatar-editor__actions">
              <button class="profile-avatar-btn profile-avatar-btn--primary" bindtap="changeProfilePhoto">{{copy.changePhotoButton}}</button>
              <button wx:if="{{profileDraft.avatarUrl}}" class="profile-avatar-btn profile-avatar-btn--ghost" bindtap="removeProfilePhoto">{{copy.removePhotoButton}}</button>
            </view>
          </view>

          <view class="profile-field">
            <text class="profile-field__label">{{copy.nameLabel}}</text>
            <view class="profile-field__picker profile-field__picker--locked">
              <text>{{profileDraft.name}}</text>
            </view>
            <text class="profile-field__hint">{{copy.nameHint}}</text>
          </view>

          <view class="profile-field">
            <text class="profile-field__label">{{copy.universityLabel}}</text>
            <view class="profile-field__picker" bindtap="openUniversitySheet">
              <text>{{universityOptions[universityIndex]}}</text>
              <text class="profile-picker__arrow">⌄</text>
            </view>
          </view>

          <view class="profile-field">
            <text class="profile-field__label">{{copy.bioLabel}}</text>
            <textarea class="profile-field__textarea" value="{{profileDraft.bio}}" maxlength="180" data-field="bio" bindinput="onProfileFieldInput" />
          </view>

          <view class="profile-actions">
            <button class="profile-action-btn profile-action-btn--cancel" bindtap="cancelEditProfile">{{copy.cancelButton}}</button>
            <button class="profile-action-btn profile-action-btn--save" bindtap="saveProfile">{{copy.saveChangesButton}}</button>
          </view>
        </view>
      </view>

      <view class="user-section">
        <view class="user-section__head">
          <text class="user-section__title">{{isOwnProfile ? copy.yourRatingTitle : copy.sellerRatingTitle}}</text>
          <text class="user-section__subtitle">{{reviewSummary.countLabel}}</text>
        </view>

        <view wx:if="{{reviewSummary.count}}" class="review-list">
          <block wx:for="{{reviewSummary.recentReviews}}" wx:key="id">
            <view class="review-card">
              <view class="review-card__head">
                <view class="review-card__identity">
                  <text class="review-card__name">{{item.reviewerName}}</text>
                  <text class="review-card__date">{{item.dateLabel}}</text>
                </view>
                <text class="review-card__rating">{{item.rating}}.0 ★</text>
              </view>
              <text wx:if="{{item.comment}}" class="review-card__comment">{{item.comment}}</text>
              <text wx:else class="review-card__comment review-card__comment--muted">{{copy.noWrittenNote}}</text>
            </view>
          </block>
        </view>

        <view wx:else class="user-empty user-empty--section">
          <text class="user-empty__title">{{copy.noReviewsTitle}}</text>
          <text class="user-empty__copy">{{copy.noReviewsCopy}}</text>
        </view>
      </view>

      <view class="user-section">
        <view class="user-section__head">
          <text class="user-section__title">{{listingsSectionTitle}}</text>
          <text class="user-section__subtitle">{{activeListingsSubtitle}}</text>
        </view>

        <view wx:if="{{listings.length}}" class="user-list">
          <block wx:for="{{listings}}" wx:key="id">
            <view class="user-card {{item.isPromoted ? 'user-card--promoted' : ''}}" data-id="{{item.id}}" bindtap="openListing">
              <view class="user-card__inner">
                <view class="user-card__media">
                  <image class="user-card__image" src="{{item.image}}" mode="aspectFill" />
                  <view wx:if="{{item.isPromoted}}" class="user-card__featured">{{item.displayPromotedBadge}}</view>
                </view>
                <view class="user-card__body">
                  <text class="user-card__price">{{item.price}}</text>
                  <text class="user-card__title">{{item.title}}</text>
                  <text class="user-card__meta">{{item.university ? item.displayLocation + ' · ' + item.university : item.displayLocation}}</text>
                  <text wx:if="{{item.address}}" class="user-card__address">{{item.address}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>

        <view wx:else class="user-empty">
          <text class="user-empty__title">{{copy.noActiveListingsTitle}}</text>
          <text class="user-empty__copy">{{copy.noActiveListingsCopy}}</text>
        </view>
      </view>

      <view wx:if="{{menuOpen}}" class="user-menu-overlay" bindtap="closeMenu">
        <view class="user-menu-sheet" catchtap="stopMenuTap">
        <view class="user-menu-sheet__handle"></view>
        <view class="user-menu-sheet__header">
          <text class="user-menu-sheet__title">{{isOwnProfile ? copy.myProfileOptionsTitle : copy.profileOptionsTitle}}</text>
          <text class="user-menu-sheet__subtitle">{{isOwnProfile ? copy.myProfileOptionsSubtitle : copy.profileOptionsSubtitle}}</text>
        </view>

          <view class="user-menu-group">
          <view class="user-menu-row-shell">
            <button class="user-menu-hit" open-type="share" bindtap="closeMenu"></button>
            <view class="user-menu-row">
              <view class="user-menu-row__icon user-menu-row__icon--share">↗</view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{copy.shareProfileTitle}}</text>
                <text class="user-menu-row__meta">{{isOwnProfile ? copy.shareOwnProfileMeta : copy.shareSellerProfileMeta}}</text>
              </view>
            </view>
          </view>

            <view class="user-menu-row" bindtap="copyProfileLink">
              <view class="user-menu-row__icon user-menu-row__icon--copy">⎘</view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{copy.copyLinkTitle}}</text>
                <text class="user-menu-row__meta">{{copy.copyLinkMeta}}</text>
              </view>
            </view>

            <view wx:if="{{isOwnProfile}}" class="user-menu-row" bindtap="startEditProfile">
              <view class="user-menu-row__icon user-menu-row__icon--edit">✎</view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{copy.editProfileMenuTitle}}</text>
                <text class="user-menu-row__meta">{{copy.editProfileMenuMeta}}</text>
              </view>
            </view>

            <view wx:elif="{{seller.wechat}}" class="user-menu-row" bindtap="copySellerWechat">
              <view class="user-menu-row__icon user-menu-row__icon--wechat">
                <view class="wechat-mark">
                  <view class="wechat-mark__bubble wechat-mark__bubble--back">
                    <view class="wechat-mark__tail wechat-mark__tail--back"></view>
                    <view class="wechat-mark__dots wechat-mark__dots--back">
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                    </view>
                  </view>
                  <view class="wechat-mark__bubble wechat-mark__bubble--front">
                    <view class="wechat-mark__tail wechat-mark__tail--front"></view>
                    <view class="wechat-mark__dots wechat-mark__dots--front">
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                      <view class="wechat-mark__dot"></view>
                    </view>
                  </view>
                </view>
              </view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{copy.writeInWechatTitle}}</text>
                <text class="user-menu-row__meta">{{copy.writeInWechatMeta}}</text>
              </view>
            </view>

            <view wx:if="{{!isOwnProfile}}" class="user-menu-row user-menu-row--danger" bindtap="blockSeller">
              <view class="user-menu-row__icon user-menu-row__icon--block">−</view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{copy.blockUserTitle}}</text>
                <text class="user-menu-row__meta">{{copy.blockUserMeta}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{!isOwnProfile}}" class="user-menu-group user-menu-group--danger">
            <view class="user-menu-row user-menu-row--danger" bindtap="reportProfile">
              <view class="user-menu-row__icon user-menu-row__icon--report">!</view>
              <view class="user-menu-row__copy">
                <text class="user-menu-row__title">{{hasReported ? copy.reportSentTitle : copy.reportProfileTitle}}</text>
                <text class="user-menu-row__meta">{{hasReported ? copy.reportSentMeta : copy.reportProfileMeta}}</text>
              </view>
            </view>
          </view>

          <view class="user-menu-cancel" bindtap="closeMenu">{{copy.menuCancel}}</view>
        </view>
      </view>

      <photo-viewer
        visible="{{viewerVisible}}"
        images="{{viewerImages}}"
        currentIndex="{{viewerIndex}}"
        bind:close="closePhotoViewer"
        bind:change="onPhotoViewerChange"
      />

      <view wx:if="{{universitySheetOpen}}" class="profile-sheet-overlay" bindtap="closeUniversitySheet">
        <view class="profile-sheet" catchtap="stopUniversitySheetTap">
          <view class="profile-sheet__handle"></view>
          <view class="profile-sheet__head">
            <text class="profile-sheet__title">{{copy.universitySheetTitle}}</text>
            <text class="profile-sheet__close" bindtap="closeUniversitySheet">{{copy.universitySheetClose}}</text>
          </view>
          <scroll-view class="profile-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{universityOptions}}"
              wx:key="*this"
              class="profile-sheet__option {{index === universityIndex ? 'profile-sheet__option--active' : ''}}"
              data-index="{{index}}"
              bindtap="onUniversityChange"
            >
              <text class="profile-sheet__option-label">{{item}}</text>
              <text wx:if="{{index === universityIndex}}" class="profile-sheet__option-check">✓</text>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <view wx:elif="{{blockedSeller}}" class="user-empty-page page-scroll__content">
      <view class="user-empty-card">
        <text class="user-empty__title">{{copy.sellerHiddenTitle}}</text>
        <text class="user-empty__copy">{{copy.sellerHiddenCopy}}</text>
      </view>
    </view>

    <view wx:elif="{{notFound}}" class="user-empty-page page-scroll__content">
      <view class="user-empty-card">
        <text class="user-empty__title">{{copy.profileUnavailableTitle}}</text>
        <text class="user-empty__copy">{{copy.profileUnavailableCopy}}</text>
      </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
<feedback-action-sheet id="feedback-action-sheet" themeMode="{{themeMode}}"></feedback-action-sheet>
