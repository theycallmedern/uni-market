.saved-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 28rpx;
}

.saved-title {
  font-size: 40rpx;
  font-weight: 700;
}

.saved-copy {
  font-size: 28rpx;
  color: #7d7d7d;
}

.saved-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 12rpx;
}

.saved-card {
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.05);
}

.saved-card__media {
  position: relative;
}

.saved-card__image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #ececec;
}

.saved-card__save {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 18rpx rgba(17, 17, 17, 0.08);
}

.saved-card__save-icon {
  font-size: 28rpx;
}

.saved-card__save--saved {
  background: rgba(17, 17, 17, 0.92);
  color: #ffffff;
}

.saved-card__save--pulse {
  animation: heart-pop 320ms ease;
}

.saved-card__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx;
}

.saved-card__price {
  font-size: 34rpx;
  font-weight: 700;
}

.saved-card__title {
  font-size: 30rpx;
  line-height: 1.3;
}

.saved-card__meta {
  font-size: 24rpx;
  color: #7f7f7f;
}

.saved-empty {
  margin-top: 24rpx;
  padding: 52rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  text-align: center;
}

.saved-empty__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.saved-empty__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d7d7d;
}

.save-feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 28rpx;
  background: rgba(40, 40, 40, 0.86);
  color: #ffffff;
  transform: translate(-50%, -50%);
  animation: feedback-pop 220ms ease;
  z-index: 20;
}

.save-feedback__icon {
  font-size: 74rpx;
  line-height: 1;
}

.save-feedback__text {
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes heart-pop {
  0% {
    transform: scale(0.88);
  }

  60% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes feedback-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.92);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
