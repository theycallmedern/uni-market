.saved-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 28rpx 168rpx;
}

.saved-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.saved-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.saved-copy {
  display: block;
  font-size: 28rpx;
  color: #7d7d7d;
}

.saved-count {
  min-width: 64rpx;
  height: 64rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #6c6c6c;
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.05);
}

.saved-controls {
  margin-top: 8rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.saved-chip-row {
  display: flex;
  gap: 12rpx;
}

.saved-chip {
  box-sizing: border-box;
  min-height: 82rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
  padding: 0 22rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  color: #2d2d2d;
}

.saved-chip--dark {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.saved-chip--wide {
  flex: 1.2;
}

.saved-chip__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) translateY(-2rpx);
  opacity: 0.72;
}

.saved-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.saved-action {
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.saved-action--danger {
  background: #fff1f1;
}

.saved-action__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
}

.saved-action__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7d7d7d;
}

.saved-action--danger .saved-action__title {
  color: #9c2727;
}

.saved-action--danger .saved-action__meta {
  color: #a86464;
}

.saved-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 12rpx;
}

.saved-card {
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.05);
}

.saved-card--promoted {
  padding: 2rpx;
  background: linear-gradient(135deg, #ff6b6b, #ffd166, #7ed957, #4dabf7, #c77dff, #ff6b6b);
  box-shadow:
    0 14rpx 28rpx rgba(17, 17, 17, 0.05),
    0 0 26rpx rgba(124, 77, 255, 0.16);
}

.saved-card__inner {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.saved-card__media {
  position: relative;
}

.saved-card__image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #ececec;
}

.saved-card__save {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 18rpx rgba(17, 17, 17, 0.08);
}

.saved-card__save-icon {
  font-size: 28rpx;
}

.saved-card__featured {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef7ee;
  color: #2f7d32;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(17, 17, 17, 0.08);
}

.saved-card__save--saved {
  background: rgba(211, 47, 47, 0.96);
  color: #ffffff;
}

.saved-card__save--pulse {
  animation: heart-pop 320ms ease;
}

.saved-card__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx;
}

.saved-card__headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.saved-card__price {
  font-size: 34rpx;
  font-weight: 700;
}

.saved-card__tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f3ee;
  font-size: 22rpx;
  color: #666666;
}

.saved-card__title {
  font-size: 30rpx;
  line-height: 1.3;
}

.saved-card__meta {
  font-size: 24rpx;
  color: #7f7f7f;
}

.saved-empty {
  margin-top: 24rpx;
  padding: 52rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  text-align: center;
}

.saved-empty__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.saved-empty__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d7d7d;
}

.save-feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 28rpx;
  background: rgba(40, 40, 40, 0.86);
  color: #ffffff;
  transform: translate(-50%, -50%);
  animation: feedback-pop 220ms ease;
  z-index: 20;
}

.save-feedback__icon {
  font-size: 74rpx;
  line-height: 1;
}

.save-feedback__text {
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes heart-pop {
  0% {
    transform: scale(0.88);
  }

  60% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes feedback-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.92);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.theme-dark .saved-title,
.theme-dark .saved-action__title,
.theme-dark .saved-card__price,
.theme-dark .saved-card__title,
.theme-dark .saved-empty__title {
  color: #f2f5f7;
}

.theme-dark .saved-copy,
.theme-dark .saved-action__meta,
.theme-dark .saved-card__meta,
.theme-dark .saved-empty__copy {
  color: #8e99a3;
}

.theme-dark .saved-count,
.theme-dark .saved-controls,
.theme-dark .saved-chip,
.theme-dark .saved-chip--dark,
.theme-dark .saved-action,
.theme-dark .saved-card,
.theme-dark .saved-empty {
  background: #171b1f;
  border-color: rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .saved-count {
  color: #8e99a3;
}

.theme-dark .saved-chip,
.theme-dark .saved-chip--dark {
  color: #f2f5f7;
}

.theme-dark .saved-card__image {
  background: #20262b;
}

.theme-dark .saved-card__inner {
  background: #171b1f;
}

.theme-dark .saved-card__save {
  background: rgba(20, 24, 27, 0.92);
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .saved-card__save--saved {
  background: rgba(211, 47, 47, 0.96);
}

.theme-dark .saved-card__tag {
  background: #20262b;
  color: #a7b2bb;
}

.theme-dark .saved-card__featured {
  background: rgba(54, 88, 60, 0.3);
  color: #b7dfbe;
}

.theme-dark .saved-action--danger {
  background: rgba(77, 30, 35, 0.34);
  border-color: rgba(180, 79, 92, 0.22);
  box-shadow: none;
}

.theme-dark .saved-action--danger .saved-action__title {
  color: #f1b3bb;
}

.theme-dark .saved-action--danger .saved-action__meta {
  color: #d89aa2;
}

.theme-dark .saved-card--promoted {
  background: linear-gradient(135deg, #ff6b6b, #ffd166, #7ed957, #4dabf7, #c77dff, #ff6b6b);
  box-shadow:
    0 16rpx 30rpx rgba(0, 0, 0, 0.24),
    0 0 26rpx rgba(124, 77, 255, 0.18);
}
