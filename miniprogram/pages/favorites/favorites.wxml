<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{copy.headerTitle}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="saved-page page-scroll__content">
      <view class="saved-head">
        <view>
          <text class="saved-title">{{copy.pageTitle}}</text>
          <text class="saved-copy">{{copy.pageCopy}}</text>
        </view>
        <view class="saved-count">{{savedCount}}</view>
      </view>

      <view wx:if="{{savedCount}}" class="saved-controls">
        <view class="saved-chip-row">
          <selector-sheet title="{{copy.sortTitle}}" options="{{sortOptions}}" value="{{sortIndex}}" theme-mode="{{themeMode}}" bindchange="onSortChange">
            <view class="saved-chip saved-chip--dark">
              <text>{{sortOptions[sortIndex]}}</text>
              <view class="saved-chip__arrow"></view>
            </view>
          </selector-sheet>

          <selector-sheet title="{{copy.categoryTitle}}" options="{{categoryOptions}}" value="{{categoryIndex}}" theme-mode="{{themeMode}}" bindchange="onCategoryChange">
            <view class="saved-chip saved-chip--wide">
              <text>{{categoryOptions[categoryIndex]}}</text>
              <view class="saved-chip__arrow"></view>
            </view>
          </selector-sheet>
        </view>

        <view class="saved-actions">
          <view class="saved-action" bindtap="removeUnavailable">
            <text class="saved-action__title">{{copy.removeUnavailableTitle}}</text>
            <text class="saved-action__meta">{{unavailableMeta}}</text>
          </view>

          <view class="saved-action saved-action--danger" bindtap="clearSaved">
            <text class="saved-action__title">{{copy.clearSavedTitle}}</text>
            <text class="saved-action__meta">{{copy.clearSavedCopy}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{listings.length}}" class="saved-list">
        <block wx:for="{{listings}}" wx:key="id">
          <view class="saved-card {{item.isPromoted ? 'saved-card--promoted' : ''}}" data-id="{{item.id}}" bindtap="openListing">
            <view class="saved-card__inner">
              <view class="saved-card__media">
                <image class="saved-card__image" src="{{item.image}}" mode="aspectFill" />
                <view wx:if="{{item.isPromoted}}" class="saved-card__featured">{{copy.promotedBadge}}</view>
                <view
                  class="saved-card__save saved-card__save--saved {{pulseListingId === item.id ? 'saved-card__save--pulse' : ''}}"
                  data-id="{{item.id}}"
                  catchtap="toggleSave"
                >
                  <text class="saved-card__save-icon">♥</text>
                </view>
              </view>
              <view class="saved-card__body">
                <view class="saved-card__headline">
                  <text class="saved-card__price">{{item.price}}</text>
                  <text class="saved-card__tag">{{item.subcategory}}</text>
                </view>
                <text class="saved-card__title">{{item.title}}</text>
                <text class="saved-card__meta">{{item.university ? item.location + ' · ' + item.university : item.location}}</text>
                <text wx:if="{{item.address}}" class="saved-card__address">{{item.address}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view wx:else class="saved-empty">
        <text class="saved-empty__title">{{emptyTitle}}</text>
        <text class="saved-empty__copy">{{emptyCopy}}</text>
      </view>

      <view wx:if="{{feedbackVisible}}" class="save-feedback">
        <view class="save-feedback__icon">{{feedbackIcon}}</view>
        <text class="save-feedback__text">{{feedbackText}}</text>
      </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
