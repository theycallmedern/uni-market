.category-page {
  padding-bottom: 48rpx;
}

.category-page--all {
  padding: 20rpx 22rpx 42rpx;
}

.all-category-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.all-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.05);
}

.all-category-item__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.all-category-item__name {
  font-size: 30rpx;
  font-weight: 700;
}

.all-category-item__hint {
  font-size: 22rpx;
  color: #7b7b7b;
}

.all-category-item__arrow {
  font-size: 42rpx;
  color: #7b7b7b;
}

.category-hero {
  margin: 18rpx 18rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
}

.category-hero--blue {
  background: #d9ebff;
}

.category-hero--electronics {
  background: #d9ebff;
}

.category-hero--green {
  background: #cdf2d4;
}

.category-hero--peach {
  background: #ffe5d2;
}

.category-hero--mint {
  background: #dcf3e7;
}

.category-hero--violet {
  background: #e8ddff;
}

.category-hero--yellow {
  background: #fff0b8;
}

.category-hero--sage {
  background: #dbe8d6;
}

.category-hero__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.category-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.75);
}

.category-icon {
  font-size: 40rpx;
}

.category-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.02;
  font-weight: 700;
}

.category-region {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.category-region-icon {
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.filter-row--two .filter-picker-wrap {
  width: 318rpx;
}

.filter-row--three .filter-picker-wrap--secondary {
  width: 262rpx;
}

.filter-picker-wrap {
  display: block;
  box-sizing: border-box;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  font-size: 30rpx;
}

.filter-pill--secondary {
  color: #7f7f7f;
}

.filter-pill--selected {
  color: #111111;
  box-shadow: 0 10rpx 22rpx rgba(17, 17, 17, 0.06);
}

.filter-arrow {
  font-size: 30rpx;
}

.quick-pill {
  padding: 0 28rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  line-height: 84rpx;
  font-size: 28rpx;
}

.quick-pill--active {
  background: linear-gradient(135deg, #ffffff, #f4f5f7);
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.06);
}

.filter-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.filter-icon-box__glyph {
  font-size: 42rpx;
}

.show-results-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff, #f4f5f7);
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  font-size: 34rpx;
  font-weight: 600;
}

.show-results-btn--muted {
  background: #f1f2f4;
  color: #9a9a9a;
  border-color: transparent;
}

.subcategory-panel,
.featured-panel {
  margin: 22rpx 18rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.panel-title,
.featured-title {
  font-size: 34rpx;
  font-weight: 700;
}

.panel-link {
  font-size: 24rpx;
  color: #6e6e6e;
}

.subcategory-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx 0;
}

.subcategory-tile {
  position: relative;
  display: flex;
  align-items: flex-end;
  width: 206rpx;
  min-height: 194rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ebe7df;
  box-sizing: border-box;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.08);
}

.subcategory-tile__image,
.subcategory-tile__scrim {
  position: absolute;
  inset: 0;
}

.subcategory-tile__image {
  width: 100%;
  height: 100%;
  display: block;
}

.subcategory-tile__scrim {
  background: linear-gradient(180deg, rgba(17, 17, 17, 0.08) 0%, rgba(17, 17, 17, 0.5) 100%);
}

.subcategory-text {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(17, 17, 17, 0.22);
}

.featured-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.featured-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f7f7f7, #efefef);
}

.featured-card__content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.featured-card__title {
  font-size: 28rpx;
  font-weight: 700;
}

.featured-card__caption {
  font-size: 24rpx;
  color: #6b6b6b;
}

.featured-card__badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.category-sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 32;
  background: rgba(17, 17, 17, 0.28);
  backdrop-filter: blur(8rpx);
}

.category-sheet {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  max-height: 70vh;
  padding: 18rpx 18rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-radius: 36rpx;
  background: linear-gradient(180deg, #ffffff, #faf8f2);
  box-shadow: 0 28rpx 56rpx rgba(17, 17, 17, 0.16);
}

.category-sheet__handle {
  display: flex;
  align-self: center;
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.14);
}

.category-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 10rpx 0;
}

.category-sheet__title {
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #111111;
}

.category-sheet__close {
  font-size: 24rpx;
  font-weight: 700;
  color: #6c6c6c;
}

.category-sheet__scroll {
  display: flex;
  flex-direction: column;
  max-height: 52vh;
}

.category-sheet__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 98rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #111111;
  box-shadow: 0 10rpx 22rpx rgba(17, 17, 17, 0.04);
}

.category-sheet__option + .category-sheet__option {
  margin-top: 12rpx;
}

.category-sheet__option--active {
  background: #eef4e7;
}

.category-sheet__option-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  color: inherit;
}

.category-sheet__option-check {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f7d32;
}

.theme-dark .all-category-item,
.theme-dark .subcategory-panel,
.theme-dark .featured-panel,
.theme-dark .featured-card {
  background: #171b1f;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .all-category-item__name,
.theme-dark .category-title,
.theme-dark .panel-title,
.theme-dark .featured-title,
.theme-dark .featured-card__title {
  color: #f2f5f7;
}

.theme-dark .all-category-item__hint,
.theme-dark .all-category-item__arrow,
.theme-dark .panel-link,
.theme-dark .featured-card__caption,
.theme-dark .category-region {
  color: #8e99a3;
}

.theme-dark .category-hero {
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.24);
}

.theme-dark .category-hero--blue {
  background: linear-gradient(135deg, #14202c, #10171f);
}

.theme-dark .category-hero--electronics {
  background: linear-gradient(135deg, #14202c, #10171f);
}

.theme-dark .category-hero--green {
  background: linear-gradient(135deg, #18231b, #101713);
}

.theme-dark .category-hero--peach {
  background: linear-gradient(135deg, #2a201b, #171210);
}

.theme-dark .category-hero--mint {
  background: linear-gradient(135deg, #15231d, #101713);
}

.theme-dark .category-hero--violet {
  background: linear-gradient(135deg, #211a2b, #15111b);
}

.theme-dark .category-hero--yellow {
  background: linear-gradient(135deg, #2d2617, #1d190f);
}

.theme-dark .category-hero--sage {
  background: linear-gradient(135deg, #1c241a, #121811);
}

.theme-dark .category-icon-btn,
.theme-dark .filter-pill,
.theme-dark .quick-pill,
.theme-dark .filter-icon-box,
.theme-dark .show-results-btn,
.theme-dark .featured-card__badge {
  background: #171b1f;
  color: #f2f5f7;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.18);
}

.theme-dark .filter-pill--secondary {
  color: #8e99a3;
}

.theme-dark .filter-pill--selected,
.theme-dark .quick-pill--active {
  background: #20262b;
  color: #f2f5f7;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .show-results-btn--muted {
  background: #171b1f;
  color: #5f6a72;
  border-color: rgba(255, 255, 255, 0.04);
}

.theme-dark .category-sheet-overlay {
  background: rgba(0, 0, 0, 0.5);
}

.theme-dark .category-sheet {
  background: linear-gradient(180deg, #171b1f, #111417);
  box-shadow: 0 28rpx 56rpx rgba(0, 0, 0, 0.32);
}

.theme-dark .category-sheet__handle {
  background: rgba(255, 255, 255, 0.12);
}

.theme-dark .category-sheet__title {
  color: #f2f5f7;
}

.theme-dark .category-sheet__close {
  color: #8e99a3;
}

.theme-dark .category-sheet__option {
  background: #171b1f;
  color: #f2f5f7;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .category-sheet__option--active {
  background: #20262b;
}

.theme-dark .category-sheet__option-check {
  color: #b7dfbe;
}
