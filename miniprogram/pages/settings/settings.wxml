<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{copy.headerTitle}}" showBack="{{true}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="settings-page page-scroll__content">
      <view class="settings-hero">
        <text class="settings-hero__eyebrow">{{copy.heroEyebrow}}</text>
        <text class="settings-hero__title">{{copy.heroTitle}}</text>
        <text class="settings-hero__copy">{{copy.heroCopy}}</text>
      </view>

      <view class="settings-section">
        <view class="settings-section__head">
          <text class="settings-section__title">{{copy.languageSectionTitle}}</text>
          <text class="settings-section__subtitle">{{copy.languageSectionSubtitle}}</text>
        </view>

        <view class="settings-actions">
          <view class="settings-theme-note">
            <view class="settings-theme-note__head">
              <view class="settings-theme-note__label-wrap">
                <view class="settings-theme-note__dot"></view>
                <text class="settings-theme-note__label">{{copy.currentLanguageLabel}}</text>
              </view>
              <view class="settings-theme-note__status settings-action__meta settings-action__meta--green">
                <text class="settings-action__meta-label">{{currentLanguageOption.title}}</text>
              </view>
            </view>
            <text class="settings-theme-note__copy">{{copy.languageSavedCopy}}</text>
          </view>

          <block wx:for="{{languageOptions}}" wx:key="code">
            <view class="settings-action {{locale === item.code ? 'settings-action--selected' : ''}}" data-locale="{{item.code}}" bindtap="setLocale">
              <view class="settings-action__row">
                <text class="settings-action__title">{{item.title}}</text>
                <view class="settings-action__meta {{locale === item.code ? 'settings-action__meta--green' : ''}}">
                  <text class="settings-action__meta-label">{{locale === item.code ? commonCopy.current : commonCopy.switch}}</text>
                </view>
              </view>
              <text class="settings-action__copy">{{item.description}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="settings-section">
        <view class="settings-section__head">
          <text class="settings-section__title">{{copy.appearanceSectionTitle}}</text>
          <text class="settings-section__subtitle">{{copy.appearanceSectionSubtitle}}</text>
        </view>

        <view class="settings-actions">
          <view class="settings-theme-note">
            <view class="settings-theme-note__head">
              <view class="settings-theme-note__label-wrap">
                <view class="settings-theme-note__dot"></view>
                <text class="settings-theme-note__label">{{copy.currentThemeLabel}}</text>
              </view>
              <view class="settings-theme-note__status settings-action__meta {{isDarkTheme ? 'settings-action__meta--purple' : 'settings-action__meta--green'}}">
                <text class="settings-action__meta-label">{{isDarkTheme ? copy.themeDark : copy.themeLight}}</text>
              </view>
            </view>
            <text class="settings-theme-note__copy">{{copy.currentThemeCopy}}</text>
          </view>

          <view class="settings-action {{!isDarkTheme ? 'settings-action--selected' : ''}}" bindtap="setLightTheme">
            <view class="settings-action__row">
              <text class="settings-action__title">{{copy.lightThemeTitle}}</text>
              <view class="settings-action__meta {{!isDarkTheme ? 'settings-action__meta--green' : ''}}">
                <text class="settings-action__meta-label">{{!isDarkTheme ? commonCopy.current : commonCopy.switch}}</text>
              </view>
            </view>
            <text class="settings-action__copy">{{copy.lightThemeCopy}}</text>
          </view>

          <view class="settings-action {{isDarkTheme ? 'settings-action--selected settings-action--selected-dark' : ''}}" bindtap="setDarkTheme">
            <view class="settings-action__row">
              <text class="settings-action__title">{{copy.darkThemeTitle}}</text>
              <view class="settings-action__meta {{isDarkTheme ? 'settings-action__meta--purple' : ''}}">
                <text class="settings-action__meta-label">{{isDarkTheme ? commonCopy.current : commonCopy.switch}}</text>
              </view>
            </view>
            <text class="settings-action__copy">{{copy.darkThemeCopy}}</text>
          </view>
        </view>
      </view>

      <view class="settings-section">
        <view class="settings-section__head">
          <text class="settings-section__title">{{copy.adminSectionTitle}}</text>
          <text class="settings-section__subtitle">{{isAdmin ? copy.adminActiveSubtitle : copy.adminLockedSubtitle}}</text>
        </view>

        <view class="settings-actions">
          <view class="settings-action">
            <view class="settings-action__row">
              <text class="settings-action__title">{{copy.adminAccessTitle}}</text>
              <view class="settings-action__meta {{isAdmin ? 'settings-action__meta--green' : ''}}">
                <text class="settings-action__meta-label">{{isAdmin ? commonCopy.active : commonCopy.locked}}</text>
              </view>
            </view>
            <text class="settings-action__copy">{{copy.adminAccessCopy}}</text>
          </view>

          <block wx:if="{{isAdmin}}">
            <view class="settings-action" bindtap="goToModeration">
              <view class="settings-action__row">
                <text class="settings-action__title">{{copy.adminOpenTitle}}</text>
                <view class="settings-action__meta">
                  <text class="settings-action__meta-label">{{commonCopy.open}}</text>
                </view>
              </view>
              <text class="settings-action__copy">{{copy.adminOpenCopy}}</text>
            </view>
            <view class="settings-action settings-action--danger" bindtap="disableAdmin">
              <view class="settings-action__row">
                <text class="settings-action__title">{{copy.adminExitTitle}}</text>
                <view class="settings-action__meta settings-action__meta--danger">
                  <text class="settings-action__meta-label">{{copy.adminExitMeta}}</text>
                </view>
              </view>
              <text class="settings-action__copy">{{copy.adminExitCopy}}</text>
            </view>
          </block>

          <block wx:else>
            <view class="settings-action" bindtap="openAdminGate">
              <view class="settings-action__row">
                <text class="settings-action__title">{{copy.adminUnlockTitle}}</text>
                <view class="settings-action__meta">
                  <text class="settings-action__meta-label">{{commonCopy.enter}}</text>
                </view>
              </view>
              <text class="settings-action__copy">{{copy.adminUnlockCopy}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
