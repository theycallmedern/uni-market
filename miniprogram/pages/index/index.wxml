<view class="page-shell page-shell--scroll">
  <app-header title="UniMarket"></app-header>

  <scroll-view
    class="page-scroll home-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="home-page page-scroll__content">
  <view class="hero">
    <view class="hero-copy">
      <text class="hero-title">Find what student life needs.</text>
      <text class="hero-subtitle">Browse housing, transport, services, and campus essentials in one place.</text>
    </view>

    <view class="hero-chip">Hangzhou</view>
  </view>

  <view class="search-bar">
    <view class="search-main">
      <text class="search-icon">🔎</text>
      <input
        class="search-input"
        placeholder="Search listings"
        value="{{search}}"
        bindinput="onSearchInput"
      />
    </view>

    <view class="filter-button" bindtap="openFilterPanel">
      <text class="filter-icon">⚙</text>
    </view>
  </view>

  <scroll-view class="categories-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="categories-grid">
      <block wx:for="{{categories}}" wx:key="id">
        <view
          class="category-card category-card--{{item.theme}} {{activeCategoryId === item.id ? 'category-card--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCategoryTap"
        >
          <text class="category-label">{{item.name}}</text>
          <view class="category-badge">
            <text class="category-emoji">{{item.emoji}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="section-head">
    <view>
      <text class="section-title">Latest Listings</text>
      <text class="section-subtitle">Fresh posts from the student community</text>
    </view>
    <text class="section-count">{{visibleListings.length}}</text>
  </view>

  <view class="listing-grid">
    <block wx:if="{{visibleListings.length}}">
      <block wx:for="{{visibleListings}}" wx:key="id">
        <view class="listing-card" data-id="{{item.id}}" bindtap="openListing">
          <view class="listing-media">
            <image class="listing-image" src="{{item.image}}" mode="aspectFill" />
            <view
              class="listing-like {{item.isSaved ? 'listing-like--saved' : ''}} {{pulseListingId === item.id ? 'listing-like--pulse' : ''}}"
              data-id="{{item.id}}"
              catchtap="toggleSave"
            >
              <text class="listing-like__icon">{{item.isSaved ? '♥' : '♡'}}</text>
            </view>
          </view>
          <view class="listing-body">
            <text class="listing-price">{{item.price}}</text>
            <text class="listing-title">{{item.title}}</text>
            <text class="listing-meta">{{item.location}}</text>
            <text wx:if="{{item.university}}" class="listing-campus">{{item.university}}</text>
          </view>
        </view>
      </block>
    </block>

    <view wx:else class="empty-state">
      <text class="empty-title">No results found</text>
      <text class="empty-copy">Try another category or adjust your search.</text>
    </view>
  </view>

  <view wx:if="{{feedbackVisible}}" class="save-feedback">
    <view class="save-feedback__icon">{{feedbackIcon}}</view>
    <text class="save-feedback__text">{{feedbackText}}</text>
  </view>

  <view wx:if="{{filterPanelOpen}}" class="filter-overlay" bindtap="closeFilterPanel">
    <view class="filter-sheet" catchtap="stopPanelTap">
      <view class="filter-sheet__handle"></view>
      <scroll-view class="filter-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="filter-sheet__head">
          <text class="filter-sheet__title">Quick filters</text>
          <text class="filter-sheet__reset" bindtap="resetHomeFilters">Reset</text>
        </view>

        <view class="filter-field">
          <text class="filter-field__label">Location</text>
          <picker mode="selector" range="{{locationOptions}}" value="{{locationIndex}}" bindchange="onLocationChange">
            <view class="filter-picker">
              <text>{{locationOptions[locationIndex]}}</text>
              <view class="filter-picker__arrow"></view>
            </view>
          </picker>
        </view>

        <view class="filter-field">
          <text class="filter-field__label">University</text>
          <picker mode="selector" range="{{universityOptions}}" value="{{universityIndex}}" bindchange="onUniversityChange">
            <view class="filter-picker">
              <text>{{universityOptions[universityIndex]}}</text>
              <view class="filter-picker__arrow"></view>
            </view>
          </picker>
        </view>

        <view class="filter-field">
          <text class="filter-field__label">Sort</text>
          <picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
            <view class="filter-picker filter-picker--dark">
              <text>{{sortOptions[sortIndex]}}</text>
              <view class="filter-picker__arrow filter-picker__arrow--light"></view>
            </view>
          </picker>
        </view>

        <view class="filter-sheet__footer">
          <view class="filter-sheet__apply" bindtap="closeFilterPanel">
            <text>Show {{visibleListings.length}} listings</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
    </view>
  </scroll-view>
</view>
