.manager-page {
  padding: 22rpx 24rpx calc(env(safe-area-inset-bottom) + 220rpx);
}

.manager-hero {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #eef4ea, #dbe7d3);
}

.manager-hero__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.manager-hero__avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.manager-hero__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.manager-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.manager-hero__meta {
  font-size: 24rpx;
  color: #56704d;
}

.manager-hero__note {
  font-size: 24rpx;
  line-height: 1.45;
  color: #707070;
}

.manager-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
  margin-bottom: 18rpx;
}

.manager-head--archive {
  margin-top: 26rpx;
}

.manager-head__copy {
  flex: 1;
  min-width: 0;
}

.manager-archive-chevron {
  font-size: 30rpx;
  color: #7b7b7b;
  line-height: 1;
  margin-left: 12rpx;
}

.manager-head__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.manager-head__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7d7d7d;
}

.manager-new {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.manager-new::after,
.manager-archive-toggle::after,
.manager-open::after,
.manager-sold::after,
.manager-promote::after,
.manager-edit::after,
.manager-delete::after,
.manager-empty__button::after {
  border: 0;
}

.manager-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.manager-list--archive {
  margin-top: 10rpx;
}

.manager-archive-shell {
  width: 100%;
}

.manager-archive-toggle {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 100% !important;
  margin: 16rpx 0 8rpx !important;
  padding: 0;
  border-radius: 30rpx;
  background: #ffffff;
  border: 0;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
  text-align: left;
  line-height: 1;
  box-sizing: border-box;
  overflow: hidden;
}

.manager-archive-toggle__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

.manager-archive-toggle .manager-head__title {
  font-size: 32rpx;
}

.manager-archive-toggle .manager-head__subtitle {
  margin-top: 10rpx;
  color: #7b7b7b;
  line-height: 1.45;
}

.manager-card {
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.manager-card--promoted {
  padding: 2rpx;
  background: linear-gradient(135deg, #ff6b6b, #ffd166, #7ed957, #4dabf7, #c77dff, #ff6b6b);
  box-shadow:
    0 16rpx 30rpx rgba(17, 17, 17, 0.05),
    0 0 26rpx rgba(124, 77, 255, 0.16);
}

.manager-card__inner {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.manager-card--archived {
  opacity: 0.96;
}

.manager-card__image {
  width: 100%;
  height: 260rpx;
  display: block;
  background: #ececec;
}

.manager-card__body {
  padding: 22rpx;
}

.manager-card__top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.manager-card__price {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.manager-card__title {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
}

.manager-card__badge {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  background: #eef5ec;
  color: #2f7d32;
  font-size: 22rpx;
  font-weight: 700;
}

.manager-card__badge--hidden {
  background: #fff1f1;
  color: #ba2d2d;
}

.manager-card__badge--sold {
  background: #eef8ef;
  color: #2f7d32;
}

.manager-card__meta,
.manager-card__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7b7b7b;
}

.manager-card__archive-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5e7759;
}

.manager-card__promo-note {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #eef7ee;
  color: #2f7d32;
}

.manager-card__promo-note--pending {
  background: #fff6e8;
  color: #8a6a1f;
}

.manager-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.manager-open,
.manager-sold,
.manager-promote,
.manager-edit,
.manager-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 calc(50% - 6rpx);
  height: 76rpx;
  padding: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  text-align: center;
}

.manager-open {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.manager-edit {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.manager-sold {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.manager-promote {
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
}

.manager-sold--active {
  background: #eef8ef;
  color: #2f7d32;
  border-color: rgba(47, 125, 50, 0.22);
}

.manager-promote--active {
  background: #eef8ef;
  color: #2f7d32;
  border-color: rgba(47, 125, 50, 0.22);
}

.manager-promote--pending {
  background: #f8f4e9;
  color: #8a6a1f;
  border-color: rgba(138, 106, 31, 0.2);
}

.manager-promote--admin {
  background: #edf3ff;
  color: #2f5fa8;
  border-color: rgba(47, 95, 168, 0.22);
}

.manager-promote[disabled] {
  opacity: 1;
  background: #ffffff;
  color: #2d2d2d;
  border-color: rgba(17, 17, 17, 0.08);
}

.manager-promote--active[disabled] {
  background: #eef8ef;
  color: #2f7d32;
  border-color: rgba(47, 125, 50, 0.22);
}

.manager-promote--pending[disabled] {
  background: #f8f4e9;
  color: #8a6a1f;
  border-color: rgba(138, 106, 31, 0.2);
}

.manager-promote--admin[disabled] {
  background: #edf3ff;
  color: #2f5fa8;
  border-color: rgba(47, 95, 168, 0.22);
}

.manager-delete {
  background: #fff1f1;
  color: #ba2d2d;
}

.manager-empty {
  margin-top: 8rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(17, 17, 17, 0.05);
}

.manager-empty__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.manager-empty__copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #7b7b7b;
}

.manager-empty__button {
  margin-top: 20rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2d2d2d;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  font-size: 28rpx;
  line-height: 92rpx;
  font-weight: 700;
}

.theme-dark .manager-hero {
  background: linear-gradient(135deg, #171c20, #111417);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.24);
}

.theme-dark .manager-hero__title,
.theme-dark .manager-head__title,
.theme-dark .manager-card__price,
.theme-dark .manager-card__title,
.theme-dark .manager-empty__title {
  color: #f2f5f7;
}

.theme-dark .manager-hero__meta,
.theme-dark .manager-head__subtitle,
.theme-dark .manager-card__meta,
.theme-dark .manager-card__sub,
.theme-dark .manager-empty__copy,
.theme-dark .manager-archive-toggle .manager-head__subtitle,
.theme-dark .manager-archive-chevron {
  color: #8e99a3;
}

.theme-dark .manager-hero__note {
  color: #a7b2bb;
}

.theme-dark .manager-new,
.theme-dark .manager-archive-toggle,
.theme-dark .manager-card,
.theme-dark .manager-card__inner,
.theme-dark .manager-open,
.theme-dark .manager-sold,
.theme-dark .manager-promote,
.theme-dark .manager-edit,
.theme-dark .manager-empty,
.theme-dark .manager-empty__button {
  background: #171b1f;
  color: #f2f5f7;
  border-color: rgba(255, 255, 255, 0.05);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
}

.theme-dark .manager-card__image {
  background: #20262b;
}

.theme-dark .manager-card__badge {
  background: rgba(54, 88, 60, 0.32);
  color: #b7dfbe;
  border: 1rpx solid rgba(111, 167, 121, 0.16);
}

.theme-dark .manager-card__badge--sold {
  background: rgba(54, 88, 60, 0.32);
  color: #b7dfbe;
  border: 1rpx solid rgba(111, 167, 121, 0.16);
}

.theme-dark .manager-card__badge--hidden {
  background: rgba(77, 30, 35, 0.34);
  color: #f1b3bb;
  border: 1rpx solid rgba(208, 103, 113, 0.18);
}

.theme-dark .manager-card__archive-note,
.theme-dark .manager-card__promo-note,
.theme-dark .manager-sold--active,
.theme-dark .manager-promote--active {
  background: rgba(54, 88, 60, 0.3);
  color: #b7dfbe;
  border-color: rgba(111, 167, 121, 0.14);
}

.theme-dark .manager-promote--pending {
  background: rgba(92, 74, 28, 0.32);
  color: #e5d3a5;
  border-color: rgba(180, 145, 70, 0.18);
}

.theme-dark .manager-promote--admin {
  background: rgba(38, 63, 97, 0.34);
  color: #bed2f0;
  border-color: rgba(101, 141, 201, 0.22);
}

.theme-dark .manager-promote[disabled] {
  opacity: 1;
  background: #171b1f;
  color: #f2f5f7;
  border-color: rgba(255, 255, 255, 0.05);
}

.theme-dark .manager-promote--active[disabled] {
  background: rgba(54, 88, 60, 0.3);
  color: #b7dfbe;
  border-color: rgba(111, 167, 121, 0.14);
}

.theme-dark .manager-promote--pending[disabled] {
  background: rgba(92, 74, 28, 0.32);
  color: #e5d3a5;
  border-color: rgba(180, 145, 70, 0.18);
}

.theme-dark .manager-promote--admin[disabled] {
  background: rgba(38, 63, 97, 0.34);
  color: #bed2f0;
  border-color: rgba(101, 141, 201, 0.22);
}

.theme-dark .manager-delete {
  background: rgba(77, 30, 35, 0.34);
  color: #f1b3bb;
  border-color: rgba(180, 79, 92, 0.22);
}

.theme-dark .manager-card--promoted {
  background: linear-gradient(135deg, #ff6b6b, #ffd166, #7ed957, #4dabf7, #c77dff, #ff6b6b);
  box-shadow:
    0 16rpx 30rpx rgba(0, 0, 0, 0.24),
    0 0 26rpx rgba(124, 77, 255, 0.18);
}
