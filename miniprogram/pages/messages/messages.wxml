<view class="page-shell page-shell--scroll {{themeClass}}">
  <app-header title="{{copy.headerTitle}}" theme="{{themeMode}}"></app-header>
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view class="manager-page page-scroll__content">
      <view class="manager-hero">
        <view class="manager-hero__avatar">
          <image wx:if="{{profile.avatarUrl}}" class="manager-hero__avatar-image" src="{{profile.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{avatarInitial}}</text>
        </view>
        <view class="manager-hero__copy">
          <text class="manager-hero__title">{{copy.heroTitle}}</text>
          <text class="manager-hero__meta">{{heroMeta}}</text>
          <text class="manager-hero__note">{{copy.heroNote}}</text>
        </view>
      </view>

      <view class="manager-head">
        <view>
          <text class="manager-head__title">{{copy.sectionTitle}}</text>
          <text class="manager-head__subtitle">{{copy.sectionSubtitle}}</text>
        </view>
        <button class="manager-new" bindtap="goToPost">{{copy.newButton}}</button>
      </view>

      <block wx:if="{{activeListings.length}}">
        <view class="manager-list">
          <block wx:for="{{activeListings}}" wx:key="id">
            <view class="manager-card {{item.isPromoted ? 'manager-card--promoted' : ''}}">
              <view class="manager-card__inner">
                <image class="manager-card__image" src="{{item.image}}" mode="aspectFill" />
                <view class="manager-card__body">
                  <view class="manager-card__top">
                    <view>
                      <text class="manager-card__price">{{item.price}}</text>
                      <text class="manager-card__title">{{item.title}}</text>
                    </view>
                    <view class="manager-card__badge {{item.isSold ? 'manager-card__badge--sold' : (item.isHiddenByModeration ? 'manager-card__badge--hidden' : '')}}">
                      {{item.displayStatusLabel}}
                    </view>
                  </view>

                  <text class="manager-card__meta">{{item.university ? item.location + ' · ' + item.university : item.location}}</text>
                  <text class="manager-card__sub">{{item.subcategory}}</text>
                  <text wx:if="{{item.isPromoted}}" class="manager-card__promo-note">{{item.displayPromotedBadge}}</text>
                  <text wx:if="{{item.isPromotionRequested}}" class="manager-card__promo-note manager-card__promo-note--pending">{{item.displayPromotionPendingLabel}}</text>

                  <view class="manager-card__actions">
                    <button class="manager-open" data-id="{{item.id}}" bindtap="openListing">{{copy.openButton}}</button>
                    <button
                      class="manager-sold {{item.isSold ? 'manager-sold--active' : ''}}"
                      data-id="{{item.id}}"
                      data-sold="{{item.isSold ? 1 : 0}}"
                      bindtap="toggleSoldState"
                    >
                      {{item.displaySoldActionLabel}}
                    </button>
                    <view
                      wx:if="{{!item.isPromoted}}"
                      class="manager-promote-shell {{item.isPromotionRequested ? 'manager-promote-shell--pending' : ''}}"
                    >
                      <button
                        class="manager-promote manager-promote--request {{item.isPromotionRequested ? 'manager-promote--pending' : ''}}"
                        data-id="{{item.id}}"
                        bindtap="requestPromotion"
                        disabled="{{item.isPromotionRequested}}"
                      >
                        {{item.displayPromoteActionLabel}}
                      </button>
                    </view>
                    <button
                      wx:else
                      class="manager-promote manager-promote--active"
                      data-id="{{item.id}}"
                      bindtap="requestPromotion"
                      disabled="{{true}}"
                    >
                      {{item.displayPromoteActionLabel}}
                    </button>
                    <button class="manager-edit" data-id="{{item.id}}" bindtap="editListing">{{copy.editButton}}</button>
                    <button class="manager-delete" data-id="{{item.id}}" bindtap="deleteListing">{{copy.deleteButton}}</button>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>

      <view wx:else class="manager-empty">
        <text class="manager-empty__title">{{copy.noActiveTitle}}</text>
        <text class="manager-empty__copy">{{copy.noActiveCopy}}</text>
      </view>

      <view wx:if="{{archivedCount}}" class="manager-archive-shell">
        <button class="manager-archive-toggle" bindtap="toggleArchive">
          <view class="manager-archive-toggle__inner">
            <view class="manager-head__copy">
              <text class="manager-head__title">{{copy.archiveTitle}}</text>
              <text class="manager-head__subtitle">{{archiveSubtitle}}</text>
            </view>
            <text class="manager-archive-chevron">{{isArchiveExpanded ? '⌃' : '⌄'}}</text>
          </view>
        </button>
      </view>

      <view wx:if="{{archivedCount && isArchiveExpanded}}" class="manager-list manager-list--archive">
        <block wx:for="{{archivedListings}}" wx:key="id">
          <view class="manager-card manager-card--archived {{item.isPromoted ? 'manager-card--promoted' : ''}}">
            <view class="manager-card__inner">
              <image class="manager-card__image" src="{{item.image}}" mode="aspectFill" />
              <view class="manager-card__body">
                <view class="manager-card__top">
                  <view>
                    <text class="manager-card__price">{{item.price}}</text>
                    <text class="manager-card__title">{{item.title}}</text>
                  </view>
                  <view class="manager-card__badge manager-card__badge--sold">
                    {{item.displayStatusLabel}}
                  </view>
                </view>

                <text class="manager-card__meta">{{item.university ? item.location + ' · ' + item.university : item.location}}</text>
                <text class="manager-card__sub">{{item.subcategory}}</text>
                <text class="manager-card__archive-note">{{item.displayArchiveNote}}</text>
                <text wx:if="{{item.isPromoted}}" class="manager-card__promo-note">{{item.displayPromotedBadge}}</text>

                <view class="manager-card__actions">
                  <button class="manager-open" data-id="{{item.id}}" bindtap="openListing">{{copy.openButton}}</button>
                  <button
                    class="manager-sold manager-sold--active"
                    data-id="{{item.id}}"
                    data-sold="1"
                    data-archived="{{item.isArchived ? 1 : 0}}"
                    bindtap="restoreArchivedListing"
                  >
                    {{item.displayRestoreActionLabel}}
                  </button>
                  <button class="manager-edit" data-id="{{item.id}}" bindtap="editListing">{{copy.editButton}}</button>
                  <button class="manager-delete" data-id="{{item.id}}" bindtap="deleteListing">{{copy.deleteButton}}</button>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>
</view>
<feedback-modal id="feedback-modal" themeMode="{{themeMode}}"></feedback-modal>
<feedback-action-sheet id="feedback-action-sheet" themeMode="{{themeMode}}"></feedback-action-sheet>
