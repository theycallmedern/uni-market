.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
}

.tabbar {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  padding: 2rpx 14rpx calc(env(safe-area-inset-bottom) - 10rpx);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 -14rpx 34rpx rgba(17, 17, 17, 0.08);
  backdrop-filter: blur(18rpx);
}

.tabbar__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  min-height: 78rpx;
}

.tabbar__item--primary {
  transform: translateY(-1rpx);
}

.tabbar__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
}

.tabbar__icon-wrap--primary {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #f5f3ee;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  box-shadow: 0 10rpx 20rpx rgba(17, 17, 17, 0.06);
}

.tabbar__item--active .tabbar__icon-wrap--primary {
  background: #eef4ea;
  border-color: #d7e5cf;
  box-shadow: 0 10rpx 22rpx rgba(79, 112, 79, 0.12);
}

.tabbar__icon {
  width: 54rpx;
  height: 54rpx;
  display: block;
}

.tabbar__icon--primary {
  width: 58rpx;
  height: 58rpx;
}

.tabbar__label {
  font-size: 25rpx;
  line-height: 1.15;
  font-weight: 600;
  color: #9b9b9b;
}

.tabbar__item--active .tabbar__label {
  color: #111111;
}

.tabbar--dark {
  background: rgba(15, 17, 19, 0.96);
  border-top-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 -14rpx 34rpx rgba(0, 0, 0, 0.28);
}

.tabbar--dark .tabbar__label {
  color: #9ca7b0;
}

.tabbar--dark .tabbar__item--active .tabbar__label {
  color: #f2f5f7;
}

.tabbar--dark .tabbar__icon {
  filter: brightness(0) invert(1);
  opacity: 0.82;
}

.tabbar--dark .tabbar__item--active .tabbar__icon {
  opacity: 1;
}

.tabbar--dark .tabbar__item--active .tabbar__icon-wrap {
  background: rgba(255, 255, 255, 0.05);
}

.tabbar--dark .tabbar__icon-wrap--primary {
  background: #1a1f23;
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.24);
}

.tabbar--dark .tabbar__item--active .tabbar__icon-wrap--primary {
  background: #20282e;
  border-color: rgba(145, 168, 153, 0.18);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.28);
}
